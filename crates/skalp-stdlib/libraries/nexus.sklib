# =============================================================================
# NCL-specific: C-element as LUT4 + feedback
# INIT = 0x00E8: Q = (A&B) | (Q_fb & (A|B))
# where A=input0, B=input1, D=Q_fb (feedback from output)
# This implements the Muller C-element for NCL dual-rail encoding.
# =============================================================================

[[cells]]
name = "OXIDE_COMB_CELEMENT"
function = "c_element"
lut_init = "0xEE88"
feedback_input = 3
fit = 0.12
inputs = ["A", "B", "C", "D"]
outputs = ["F"]
nominal_voltage_mv = 900
min_voltage_mv = 810

[[cells.failure_modes]]
name = "config_upset"
fit = 0.05
fault_type = "data_retention"
mechanism = "sram_soft_error"

[[cells.failure_modes]]
name = "stuck_at_0"
fit = 0.015
fault_type = "stuck_at_0"
mechanism = "oxide_breakdown"

[[cells.failure_modes]]
name = "stuck_at_1"
fit = 0.015
fault_type = "stuck_at_1"
mechanism = "electromigration"

[[cells.failure_modes]]
name = "feedback_open"
fit = 0.010
fault_type = "open"
mechanism = "feedback_routing_failure"

[[cells.failure_modes]]
name = "hysteresis_loss"
fit = 0.008
fault_type = "transient"
mechanism = "lut_init_corruption"
