# =============================================================================
# DIFFIO18 - Differential I/O (LVDS, SLVS)
# For high-speed differential signaling.
# =============================================================================

[[cells]]
name = "DIFFIO18"
function = "bidir_pad"
fit = 0.30
nominal_voltage_mv = 1800
min_voltage_mv = 1000

[cells.io_info]
supported_standards = ["LVDS", "SLVS", "SUBLVDS", "MLVDS"]
max_drive_strength_ma = 8
supports_tristate = true
supports_differential = true
has_input_register = true
has_output_register = true

[cells.io_info.pin_map]
data_in = "O"
data_out = "I"
output_enable = "T"
pad = "PADP"
pad_n = "PADN"

[[cells.failure_modes]]
name = "esd_damage"
fit = 0.08
fault_type = "stuck_at_0"
mechanism = "esd_latchup"

[[cells.failure_modes]]
name = "common_mode"
fit = 0.06
fault_type = "stuck_at_0"
mechanism = "common_mode_failure"

[[cells.failure_modes]]
name = "skew"
fit = 0.05
fault_type = "delay"
mechanism = "differential_skew"

[[cells.failure_modes]]
name = "transient"
fit = 0.05
fault_type = "transient"
mechanism = "single_event_transient"

# =============================================================================
# VCC / GND - Constant drivers
# =============================================================================

[[cells]]
name = "VCC"
function = "tie_high"
fit = 0.01
inputs = []
outputs = ["V"]
nominal_voltage_mv = 900
min_voltage_mv = 810

[[cells.failure_modes]]
name = "stuck_at_0"
fit = 0.005
fault_type = "stuck_at_0"
mechanism = "routing_open"

[[cells]]
name = "GND"
function = "tie_low"
fit = 0.01
inputs = []
outputs = ["G"]
nominal_voltage_mv = 900
min_voltage_mv = 810

[[cells.failure_modes]]
name = "stuck_at_1"
fit = 0.005
fault_type = "stuck_at_1"
mechanism = "routing_short"

# =============================================================================
# Named LUT4 variants for tech mapping convenience
# These are OXIDE_COMB cells with specific INIT values pre-calculated.
# The tech mapper will set lut_init on the Cell when instantiating.
# =============================================================================

# Inverter (INIT = 0x5555: ~I0)
[[cells]]
name = "OXIDE_COMB_INV"
function = "inv"
lut_init = "0x5555"
fit = 0.10
inputs = ["A"]
outputs = ["F"]
nominal_voltage_mv = 900
min_voltage_mv = 810

[[cells.failure_modes]]
name = "config_upset"
fit = 0.04
fault_type = "data_retention"
