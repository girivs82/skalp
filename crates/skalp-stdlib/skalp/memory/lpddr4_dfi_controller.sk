// LPDDR4 controller for one x16 channel on the DFI 1:4 interface.
//
// It runs on the DFI clock (one cycle per 4 CK, phases p0..p3 one CK each) and sends at most one
// command per cycle: a 4-CK command (ACT, RD/WR + CAS-2, MRW, MRR, MPC + CAS-2) fills all four
// phases, a 2-CK command (PRE, REF, MPC) phases p0 and p1. Every JEDEC timing is converted to
// DFI cycles from the CK edges the DRAM measures it between, so it holds for any CK as long as
// the generics (in CK cycles, nCK) are right for it.
//
// Sequence: DFI init (dfi_init_start until dfi_init_complete), RESET_N low T_INIT1_CYC cycles,
// CKE low T_INIT3_CYC, CKE high T_INIT5_CYC, mode registers (MR13, MR1, MR2, MR3, MR11, MR12,
// MR14, MR22, and the Read DQ Calibration invert masks and patterns MR15, MR20, MR32, MR40, from
// the generics: the PHY's training compares with them, so they are written rather than left at
// the DRAM's defaults, MR15/MR20 = 0x55), ZQ calibration start and latch, then training through the PHY
// (DFI PHY-evaluation mode, each step until the PHY reports every byte lane done):
//   write leveling: MR2 with OP7 (WR-LEV) set, tWLMRD, dfi_wrlvl_en with a dfi_wrlvl_strobe
//     every WL_GAP_CYC cycles (at most WL_MAX_STROBES), then MR2 back;
//   read gate, then read eye: Read DQ Calibration reads (at most TRAIN_MAX_READS);
//   write DQ: dfi_wdqlvl_en with a write and a read-back of TRAIN_ADDR in turn (at most
//     TRAIN_MAX_READS pairs; the bank is left open);
//   VREF(DQ) (VREF_TRAIN = 1): the reference is swept from level VREF_LO_LEVEL to VREF_HI_LEVEL
//     in VREF_STEP steps. A level is in 0.4 % of VDDQ (25 = 10 %, 105 = 42 %), across both MR14
//     ranges: levels up to 75 are range 0 (OP6 = 0, code = level - 25), higher ones range 1
//     (code = level - 55). Each setting: all banks closed (and a refresh when one is due), MRW
//     MR14, TVREF_NCK to settle, then VREF_REPS times three bursts written to TRAIN_ADDR and the
//     two columns below it and read back: isolated ones (beat k drives DQ k and DQ k+8 only,
//     what a reference set too high loses), isolated zeros (the inverse, lost to one too low)
//     and every line toggling. MR14 is set to the middle of the longest run of settings whose
//     bursts all came back right (none: train_fail, and MR14 as the generic gives), and write
//     DQ training runs again at it, as its eye depends on the reference;
// then MRR of MR5 and MR8, then normal operation. A step that runs out sets train_fail.
//
// Normal operation: one request at a time, in order, open-page per bank (row hit: CAS; other row
// open: PRE then ACT; closed: ACT), all-bank refresh every tREFI (PREab, REF, then a DFI
// controller update), and PHY update windows: while dfi_phyupd_req is high no new request is taken,
// and the window is granted once nothing is on the bus.
//
// User port (DFI clock): a request is taken when req_valid and req_ready are both high.
// req_addr = {row[16:0], bank[2:0], column[9:4]}, one BL16 burst (32 bytes) per request; write
// data: beat k in req_wdata[16k+15:16k]. Read data comes back in request order on rsp_valid /
// rsp_rdata, in the same layout. Data mask is off (MR13 DMD), so writes are whole bursts.
//
// Bus safety: a write CAS follows a read CAS by no less than RL - WL + tDQSCK(max) + 10 nCK plus
// RTW_GUARD_NCK (the read burst, its postamble and the write preamble cannot overlap), and write
// data enables follow only write commands.
//
// PHY adjustments: the first write data slot is the write command's slot + WL + TPHY_WRLAT_ADJ,
// the first read data slot the read command's slot + RL + TRDDATA_EN_ADJ (3 and 3 for the
// behavioural PHY, whose writes reach the pins one tCK after commands when not yet leveled).
pub entity Lpddr4DfiController<
    const MR1: nat = 20,
    const MR2: nat = 9,
    const MR3: nat = 49,
    const MR11: nat = 0,
    const MR12: nat = 114,
    const MR13: nat = 32,
    const MR14: nat = 114,
    const MR22: nat = 0,
    const T_INIT1_CYC: nat = 26667,
    const T_INIT3_CYC: nat = 266667,
    const T_INIT5_CYC: nat = 267,
    const TRCD_NCK: nat = 10,
    const TRP_NCK: nat = 12,
    const TRAS_NCK: nat = 23,
    const TRRD_NCK: nat = 6,
    const TFAW_NCK: nat = 22,
    const TRFC_NCK: nat = 70,
    const TREFI_NCK: nat = 2080,
    const TWR_NCK: nat = 10,
    const TWTR_NCK: nat = 8,
    const TRTP_NCK: nat = 8,
    const TMRW_NCK: nat = 10,
    const TZQCAL_NCK: nat = 534,
    const TZQLAT_NCK: nat = 16,
    const DQSCK_MAX_NCK: nat = 2,
    const RTW_GUARD_NCK: nat = 2,
    const TPHY_WRLAT_ADJ: nat = 3,
    const TRDDATA_EN_ADJ: nat = 3,
    const TRAIN_GAP_CYC: nat = 16,
    const TRAIN_MAX_READS: nat = 64,
    const CTRLUPD_CYC: nat = 4,
    const TWLMRD_NCK: nat = 40,
    const WL_GAP_CYC: nat = 16,
    const WL_MAX_STROBES: nat = 40,
    const TRAIN_ADDR: nat = 63,
    // Read DQ Calibration invert masks and patterns (last, so positional generics before them
    // keep their places)
    const MR15: nat = 0,
    const MR20: nat = 0,
    const MR32: nat = 90,
    const MR40: nat = 60,
    // VREF(DQ) training (see above): on (1) or off (0), the levels swept (25 to 105, both MR14
    // ranges), the step between them, the write/read-back rounds per level (1 to 255), and the
    // settling time after each MR14 write (tVREF_LONG, 250 ns: 134 nCK at 1066 Mbps)
    const VREF_TRAIN: nat = 1,
    const VREF_LO_LEVEL: nat = 25,
    const VREF_HI_LEVEL: nat = 105,
    const VREF_STEP: nat = 2,
    const VREF_REPS: nat = 4,
    const TVREF_NCK: nat = 134
> {
    in clk: clock
    // ---------------------------------------------------------------- user port
    in req_valid: bit
    out req_ready: bit
    in req_write: bit
    in req_addr: bit[26]
    in req_wdata: bit[256]
    out rsp_valid: bit
    out rsp_rdata: bit[256]
    out init_done: bit
    out train_fail: bit
    out mr5: bit[8]
    out mr8: bit[8]
    out state: bit[5]
    // MR14 as written after training (the generic when VREF training is off)
    out vref: bit[8]
    // VREF training: the longest passing run's first and last levels {last, first}, and one bit
    // per level swept (1 = its bursts came back right), the last level in bit 0
    out vref_win: bit[14]
    out vref_map: bit[64]
    // ---------------------------------------------------------------- DFI
    out dfi_cs_p0: bit
    out dfi_address_p0: bit[6]
    out dfi_cke_p0: bit
    out dfi_reset_n_p0: bit
    out dfi_cs_p1: bit
    out dfi_address_p1: bit[6]
    out dfi_cke_p1: bit
    out dfi_reset_n_p1: bit
    out dfi_cs_p2: bit
    out dfi_address_p2: bit[6]
    out dfi_cke_p2: bit
    out dfi_reset_n_p2: bit
    out dfi_cs_p3: bit
    out dfi_address_p3: bit[6]
    out dfi_cke_p3: bit
    out dfi_reset_n_p3: bit
    out dfi_wrdata_en_p0: bit
    out dfi_wrdata_p0: bit[32]
    out dfi_wrdata_mask_p0: bit[4]
    out dfi_rddata_en_p0: bit
    out dfi_wrdata_en_p1: bit
    out dfi_wrdata_p1: bit[32]
    out dfi_wrdata_mask_p1: bit[4]
    out dfi_rddata_en_p1: bit
    out dfi_wrdata_en_p2: bit
    out dfi_wrdata_p2: bit[32]
    out dfi_wrdata_mask_p2: bit[4]
    out dfi_rddata_en_p2: bit
    out dfi_wrdata_en_p3: bit
    out dfi_wrdata_p3: bit[32]
    out dfi_wrdata_mask_p3: bit[4]
    out dfi_rddata_en_p3: bit
    in dfi_rddata_w0: bit[32]
    in dfi_rddata_valid_w0: bit
    in dfi_rddata_w1: bit[32]
    in dfi_rddata_valid_w1: bit
    in dfi_rddata_w2: bit[32]
    in dfi_rddata_valid_w2: bit
    in dfi_rddata_w3: bit[32]
    in dfi_rddata_valid_w3: bit
    out dfi_init_start: bit
    in dfi_init_complete: bit
    out dfi_ctrlupd_req: bit
    in dfi_ctrlupd_ack: bit
    in dfi_phyupd_req: bit
    out dfi_phyupd_ack: bit
    out dfi_rdlvl_gate_en: bit
    out dfi_rdlvl_en: bit
    in dfi_rdlvl_gate_resp: bit[2]
    in dfi_rdlvl_resp: bit[2]
    out dfi_wrlvl_en: bit
    out dfi_wrlvl_strobe: bit
    in dfi_wrlvl_resp: bit[2]
    out dfi_wdqlvl_en: bit
    in dfi_wdqlvl_resp: bit[2]
}

// Timing state of one bank, in DFI cycles. Each count is the number of cycles after the event
// before the next command it gates may go; the inputs give them (constant in a design).
pub entity Lpddr4BankState {
    in clk: clock
    in act: bit
    in pre: bit
    in rd: bit
    in wr: bit
    in row_in: bit[17]
    in f_rcd: bit[8]
    in f_ras: bit[8]
    in f_rp: bit[8]
    in f_wr: bit[8]
    in f_rtp: bit[8]
    out is_open: bit
    out row: bit[17]
    out act_ok: bit
    out cas_ok: bit
    out pre_ok: bit
}

impl Lpddr4BankState {
    signal open_r: bit = 0
    signal row_r: bit[17] = 0
    signal t_act: bit[8] = 0
    signal t_cas: bit[8] = 0
    signal t_pre: bit[8] = 0
    let act_d: bit[8] = if t_act == 0 { 0 } else { t_act - 1 }
    let cas_d: bit[8] = if t_cas == 0 { 0 } else { t_cas - 1 }
    let pre_d: bit[8] = if t_pre == 0 { 0 } else { t_pre - 1 }
    let rcd_m1: bit[8] = if f_rcd == 0 { 0 } else { f_rcd - 1 }
    let ras_m1: bit[8] = if f_ras == 0 { 0 } else { f_ras - 1 }
    let rp_m1: bit[8] = if f_rp == 0 { 0 } else { f_rp - 1 }
    let wr_m1: bit[8] = if f_wr == 0 { 0 } else { f_wr - 1 }
    let rtp_m1: bit[8] = if f_rtp == 0 { 0 } else { f_rtp - 1 }
    // the precharge wait after a write or a read, worked out before the command is known, so
    // the command only picks one
    let pre_w: bit[8] = if wr_m1 > pre_d { wr_m1 } else { pre_d }
    let pre_r: bit[8] = if rtp_m1 > pre_d { rtp_m1 } else { pre_d }
    // each wait is over when its timer is 0; the flags are registers, set from the value each
    // timer takes, so the controller's command choice starts from them directly
    signal act_ok_r: bit = 1
    signal cas_ok_r: bit = 1
    signal pre_ok_r: bit = 1
    on(clk.rise) {
        if act == 1 {
            open_r = 1
            row_r = row_in
            t_cas = rcd_m1
            t_pre = ras_m1
            cas_ok_r = if rcd_m1 == 0 { 1 } else { 0 }
            pre_ok_r = if ras_m1 == 0 { 1 } else { 0 }
        } else {
            t_cas = cas_d
            t_pre = if wr == 1 { pre_w } else { if rd == 1 { pre_r } else { pre_d } }
            cas_ok_r = if cas_d == 0 { 1 } else { 0 }
            pre_ok_r = if wr == 1 { if pre_w == 0 { 1 } else { 0 } } else { if rd == 1 { if pre_r == 0 { 1 } else { 0 } } else { if pre_d == 0 { 1 } else { 0 } } }
        }
        if pre == 1 {
            open_r = 0
            t_act = rp_m1
            act_ok_r = if rp_m1 == 0 { 1 } else { 0 }
        } else {
            t_act = act_d
            act_ok_r = if act_d == 0 { 1 } else { 0 }
        }
    }
    is_open = open_r
    row = row_r
    act_ok = act_ok_r
    cas_ok = cas_ok_r
    pre_ok = pre_ok_r
}

// word i (beats 2i, 2i+1) of a BL16 burst
fn burst_word(d: bit[256], i: bit[3]) -> bit[32] {
    return match i {
        0 => d[31:0],
        1 => d[63:32],
        2 => d[95:64],
        3 => d[127:96],
        4 => d[159:128],
        5 => d[191:160],
        6 => d[223:192],
        _ => d[255:224]
    }
}

fn dec8(x: bit[8]) -> bit[8] {
    return if x == 0 { 0 } else { x - 1 }
}

fn max8(a: bit[8], b: bit[8]) -> bit[8] {
    return if a > b { a } else { b }
}

fn rsel(a: bit[32], b: bit[32], c: bit[32], d: bit[32], i: bit[2]) -> bit[32] {
    return match i {
        0 => a,
        1 => b,
        2 => c,
        _ => d
    }
}

fn z8(x: bit[8]) -> bit {
    return if x == 0 { 1 } else { 0 }
}

fn le1(x: bit[8]) -> bit {
    return if x <= 1 { 1 } else { 0 }
}

// command frames: {p3, p2, p1, p0} CA words; 4-CK commands have CS on p0 and p2, 2-CK on p0
fn ca_act(row: bit[17], ba: bit[3]) -> bit[24] {
    return {row[5:0], row[9:6], 2'b11, row[11:10], row[16], ba, row[15:12], 2'b01}
}
fn ca_cas(op: bit[5], ba: bit[3], col: bit[6]) -> bit[24] {
    return {col[3:0], 2'b00, col[4], 5'b10010, 1'b0, col[5], 1'b0, ba, 1'b0, op}
}
fn ca_mrw(ma: bit[6], op: bit[8]) -> bit[24] {
    return {op[5:0], op[6], 5'b10110, ma, op[7], 5'b00110}
}
fn ca_mrr(ma: bit[6]) -> bit[24] {
    return {6'b000000, 1'b0, 5'b10010, ma, 1'b0, 5'b01110}
}
fn ca_mpc(op: bit[7]) -> bit[24] {
    return {6'b000000, 1'b0, 5'b10010, op[5:0], op[6], 5'b00000}
}

// VREF(DQ) training bursts (beat k in [16k+15:16k]): isolated ones (beat k drives DQ k and
// DQ k+8, so each line carries one 1 among zeros), isolated zeros, every line toggling
fn vr_pat(i: bit[2]) -> bit[256] {
    let ones: bit[256] = {64'h8000400020001000, 64'h0800040002000100, 64'h0080004000200010, 64'h0008000400020001}
    let zeros: bit[256] = {64'h7FFFBFFFDFFFEFFF, 64'hF7FFFBFFFDFFFEFF, 64'hFF7FFFBFFFDFFFEF, 64'hFFF7FFFBFFFDFFFE}
    let toggle: bit[256] = {64'h5555AAAA5555AAAA, 64'h5555AAAA5555AAAA, 64'h5555AAAA5555AAAA, 64'h5555AAAA5555AAAA}
    return if i == 0 { ones } else { if i == 1 { zeros } else { toggle } }
}

impl Lpddr4DfiController {
    // ------------------------------------------------------------ states
    // 0 PHY init, 1 reset low, 2 CKE low, 3 CKE high, 4 MRW, 5 ZQ start, 6 ZQ wait, 7 ZQ latch,
    // 18 write leveling, 10 gate training, 11 read-eye training, 19 write DQ training,
    // 20 VREF(DQ) training (then 19 again), 8 MRR, 9 wait for MRR data, 12 settle, 13 ready,
    // 14 refresh precharge, 15 refresh, 16 PHY update, 17 controller update
    signal st: bit[5] = 0
    signal wait_c: bit[32] = 0
    signal mi: bit[4] = 0
    signal init_done_r: bit = 0
    signal train_fail_r: bit = 0
    signal mr5_r: bit[8] = 0
    signal mr8_r: bit[8] = 0
    signal train_reads: bit[16] = 0
    signal train_gap: bit[16] = 0
    signal gate_en_r: bit = 0
    signal rdlvl_en_r: bit = 0
    signal wrlvl_en_r: bit = 0
    signal wrlvl_strobe_r: bit = 0
    signal wdqlvl_en_r: bit = 0
    // write leveling step: 0 MRW in, 1 tWLMRD, 2 strobes, 3 MRW out
    signal wl_ph: bit[2] = 0
    // write DQ training: the next training request is a write
    signal tw_w: bit = 0
    // VREF(DQ) training: step 0 close banks, 1 refresh if due, 2 MRW MR14, 3 settle, 4 the
    // writes and reads, 5 wait for the reads and judge the code
    signal vr_ph: bit[3] = 0
    // the level being tried (the chosen one once vr_fin is set); MR14 as the generic gives it
    // when none passed
    signal vr_c: bit[7] = 0
    signal vr_fin: bit = 0
    signal vr_keep: bit = 0
    // VREF training is over (write DQ training's second run is after it)
    signal vr_done: bit = 0
    // requests issued in this round (3 writes, then 3 reads), rounds done for this level, the
    // next read-back's pattern, read-backs compared for this level, any wrong
    signal vr_k: bit[3] = 0
    signal vr_r: bit[8] = 0
    signal vr_gi: bit[2] = 0
    signal vr_got: bit[10] = 0
    signal vr_bad: bit = 0
    // a read-back and its pattern, held a cycle so the comparison starts from registers
    signal vr_rb: bit[256] = 0
    signal vr_rbi: bit[2] = 0
    signal vr_rbv: bit = 0
    // the passing run being counted, and the longest so far
    signal vr_rs: bit[7] = 0
    signal vr_cl: bit[7] = 0
    signal vr_bs: bit[7] = 0
    signal vr_be: bit[7] = 0
    signal vr_bl: bit[7] = 0
    signal vr_map: bit[64] = 0
    signal vref_r: bit[8] = MR14
    signal init_start_r: bit = 0
    signal ctrlupd_r: bit = 0
    signal phyupd_ack_r: bit = 0
    signal reset_r: bit = 0
    signal cke_r: bit = 0
    // refresh
    signal refc: bit[16] = 0
    signal ref_due: bit = 0
    signal ref_on: bit = 0
    // global timers (DFI cycles)
    signal t_cmd: bit[8] = 0
    signal t_actg: bit[8] = 0
    signal t_rd: bit[8] = 0
    signal t_wr: bit[8] = 0
    signal t_ref: bit[8] = 0
    signal faw0: bit[8] = 0
    signal faw1: bit[8] = 0
    signal faw2: bit[8] = 0
    signal faw3: bit[8] = 0
    signal fp: bit[2] = 0
    // Whether each wait above is over (its count is 0), and whether the queues and data rings
    // have room or are empty. They are registers, set from the value each count takes, so the
    // command choice starts from them directly instead of from comparisons on the counts.
    signal cmd_z: bit = 1
    signal actg_z: bit = 1
    signal rd_z: bit = 1
    signal wr_z: bit = 1
    signal fz0: bit = 1
    signal fz1: bit = 1
    signal fz2: bit = 1
    signal fz3: bit = 1
    signal wq_room: bit = 1
    signal wq_z: bit = 1
    signal tq_room: bit = 1
    signal tq_z: bit = 1
    signal wrr_z: bit = 1
    signal rdr_z: bit = 1
    // the request being served
    signal rq_v: bit = 0
    // the request's row is the one open in its bank (see q_hit)
    signal rq_rowm: bit = 0
    signal rq_w: bit = 0
    signal rq_row: bit[17] = 0
    signal rq_ba: bit[3] = 0
    // rq_ba one-hot, so each bank's command strobe needs only that bank's flags
    signal rq_sel: bit[8] = 1
    signal rq_col: bit[6] = 0
    signal rq_data: bit[256] = 0
    // data enables, one bit per CK slot ahead (bit 0 = phase p0 of this cycle)
    signal wr_ring: bit[64] = 0
    signal rd_ring: bit[64] = 0
    // each write slot's beat pair (word of its burst), three bits per slot, beside wr_ring
    signal wb_ring: bit[192] = 0
    // write bursts waiting to go out
    signal wq: [bit[256]; 4]
    signal wq_wp: bit[2] = 0
    signal wq_rp: bit[2] = 0
    // wq_rp + 1, kept in its own register so the second read address is
    // ready at the clock edge
    signal wq_rp1: bit[2] = 1
    signal wq_n: bit[3] = 0
    // reads in flight: 0 user, 1 MR5, 2 MR8, 3 VREF training
    signal tq: [bit[2]; 8]
    signal tq_wp: bit[3] = 0
    signal tq_rp: bit[3] = 0
    signal tq_n: bit[4] = 0
    // read words as the PHY returned them, registered before they are assembled
    signal ri0: bit[32] = 0
    signal ri1: bit[32] = 0
    signal ri2: bit[32] = 0
    signal ri3: bit[32] = 0
    // how many of ri0..ri3 hold a word (the valid words are packed to the front)
    signal r_n: bit[3] = 0
    // read words assembled into bursts
    signal rc: bit[4] = 0
    signal rw0: bit[32] = 0
    signal rw1: bit[32] = 0
    signal rw2: bit[32] = 0
    signal rw3: bit[32] = 0
    signal rw4: bit[32] = 0
    signal rw5: bit[32] = 0
    signal rw6: bit[32] = 0
    signal rw7: bit[32] = 0
    signal rsp_v_r: bit = 0
    signal rsp_d_r: bit[256] = 0
    // DFI outputs
    signal o_cs: bit[4] = 0
    signal o_ca: bit[24] = 0
    signal o_cke: bit = 0
    signal o_rst: bit = 0
    signal o_we: bit[4] = 0
    signal o_wd: bit[128] = 0
    signal o_re: bit[4] = 0

    // ------------------------------------------------------------ constants
    let mr1_c: bit[8] = MR1
    let mr2_c: bit[8] = MR2
    let mr3_c: bit[8] = MR3
    let mr11_c: bit[8] = MR11
    let mr12_c: bit[8] = MR12
    let mr13_c: bit[8] = MR13
    let mr14_c: bit[8] = MR14
    let mr22_c: bit[8] = MR22
    let mr15_c: bit[8] = MR15
    let mr20_c: bit[8] = MR20
    let mr32_c: bit[8] = MR32
    let mr40_c: bit[8] = MR40
    let rl: bit[16] = match mr2_c[2:0] {
        0 => 6,
        1 => 10,
        2 => 14,
        3 => 20,
        4 => 24,
        5 => 28,
        6 => 32,
        _ => 36
    }
    let wl_a: bit[16] = match mr2_c[5:3] {
        0 => 4,
        1 => 6,
        2 => 8,
        3 => 10,
        4 => 12,
        5 => 14,
        6 => 16,
        _ => 18
    }
    let wl_b: bit[16] = match mr2_c[5:3] {
        0 => 4,
        1 => 8,
        2 => 12,
        3 => 18,
        4 => 22,
        5 => 26,
        6 => 30,
        _ => 34
    }
    let wl: bit[16] = if mr2_c[6] == 1 { wl_b } else { wl_a }
    let n_rcd: bit[16] = TRCD_NCK
    let n_rp: bit[16] = TRP_NCK
    let n_ras: bit[16] = TRAS_NCK
    let n_rrd: bit[16] = TRRD_NCK
    let n_faw: bit[16] = TFAW_NCK
    let n_rfc: bit[16] = TRFC_NCK
    let n_refi: bit[16] = TREFI_NCK
    let n_wr: bit[16] = TWR_NCK
    let n_wtr: bit[16] = TWTR_NCK
    let n_rtp: bit[16] = TRTP_NCK
    let n_mrw: bit[16] = TMRW_NCK
    let n_zqcal: bit[16] = TZQCAL_NCK
    let n_zqlat: bit[16] = TZQLAT_NCK
    let n_dqsck: bit[16] = DQSCK_MAX_NCK
    let n_guard: bit[16] = RTW_GUARD_NCK
    let adj_w: bit[16] = TPHY_WRLAT_ADJ
    let adj_r: bit[16] = TRDDATA_EN_ADJ
    // DFI cycles between commands, from the CK edges the DRAM measures each timing between
    // (second cycles of 2-cycle commands: a 4-CK command's is on p3, a 2-CK command's on p1)
    let f_rcd16: bit[16] = (n_rcd + 5) >> 2
    let f_ras16: bit[16] = (n_ras + 5) >> 2
    let f_rp16: bit[16] = (n_rp + 3) >> 2
    let f_rfc16: bit[16] = (n_rfc + 3) >> 2
    let f_rrd16: bit[16] = (n_rrd + 3) >> 2
    let f_faw16: bit[16] = (n_faw + 3) >> 2
    let f_wtr16: bit[16] = (wl + n_wtr + 12) >> 2
    let f_rtw16: bit[16] = (rl - wl + n_dqsck + n_guard + 13) >> 2
    let f_wr16: bit[16] = (wl + n_wr + 14) >> 2
    let f_rtp16: bit[16] = (n_rtp + 5) >> 2
    let f_mrw16: bit[16] = (n_mrw + 6) >> 2
    let f_zqcal32: bit[32] = {16'h0000, (n_zqcal + 3) >> 2}
    let f_zqlat16: bit[16] = (n_zqlat + 4) >> 2
    let f_refi: bit[16] = n_refi >> 2
    let f_rcd: bit[8] = f_rcd16[7:0]
    let f_ras: bit[8] = f_ras16[7:0]
    let f_rp: bit[8] = f_rp16[7:0]
    let f_wr: bit[8] = f_wr16[7:0]
    let f_rtp: bit[8] = f_rtp16[7:0]
    let m1_rp: bit[8] = dec8(f_rp16[7:0])
    let m1_rfc: bit[8] = dec8(f_rfc16[7:0])
    let m1_rrd: bit[8] = dec8(f_rrd16[7:0])
    let m1_faw: bit[8] = dec8(f_faw16[7:0])
    let m1_wtr: bit[8] = dec8(f_wtr16[7:0])
    let m1_rtw: bit[8] = dec8(f_rtw16[7:0])
    let m1_mrw: bit[8] = dec8(f_mrw16[7:0])
    let m1_zqlat: bit[8] = dec8(f_zqlat16[7:0])
    // tCCD (8 nCK) is two cycles; tMRR (8 nCK after an MRR's last edge) three
    let m1_ccd: bit[8] = 1
    let m1_mrr: bit[8] = 2
    let wr_off: bit[16] = wl + adj_w
    let rd_off: bit[16] = rl + adj_r
    let wr_mask: bit[64] = 64'h00000000000000FF << wr_off[5:0]
    // words 0 to 7 of a burst in its eight slots
    let wb_off: bit[8] = {wr_off[5:0], 2'b00} - {2'b00, wr_off[5:0]}
    let wb_mask: bit[192] = {168'h0, 24'hFAC688} << wb_off
    let rd_mask: bit[64] = 64'h00000000000000FF << rd_off[5:0]
    let i1_cyc: bit[32] = T_INIT1_CYC
    let i3_cyc: bit[32] = T_INIT3_CYC
    let i5_cyc: bit[32] = T_INIT5_CYC
    let tr_gap: bit[16] = TRAIN_GAP_CYC
    let tr_max: bit[16] = TRAIN_MAX_READS
    let cu_cyc: bit[32] = CTRLUPD_CYC
    let n_wlmrd: bit[16] = TWLMRD_NCK
    // tWLMRD from the MRW's last edge (p3) to the first DQS pulse (p1, two cycles later at the pins)
    let wlmrd32: bit[32] = {16'h0000, (n_wlmrd + 3) >> 2}
    let wl_gap: bit[16] = WL_GAP_CYC
    let wl_max: bit[16] = WL_MAX_STROBES
    let tr_addr: bit[26] = TRAIN_ADDR
    let vr_on_c: bit[8] = VREF_TRAIN
    let vr_on: bit = if vr_on_c == 0 { 0 } else { 1 }
    let vr_lo: bit[7] = VREF_LO_LEVEL
    let vr_hi7: bit[7] = VREF_HI_LEVEL
    let vr_step7: bit[7] = VREF_STEP
    let vr_reps: bit[8] = VREF_REPS
    // read-backs per level: three per round
    let vr_nrd: bit[10] = {2'b00, vr_reps} + {2'b00, vr_reps} + {2'b00, vr_reps}
    let n_tvref: bit[16] = TVREF_NCK
    // from the MRW's last edge
    let tvref32: bit[32] = {16'h0000, (n_tvref + 3) >> 2}

    // ------------------------------------------------------------ banks
    let req_row: bit[17] = req_addr[25:9]
    let req_ba: bit[3] = req_addr[8:6]
    let req_col: bit[6] = req_addr[5:0]
    let b_open: bit[8] = {b7.is_open, b6.is_open, b5.is_open, b4.is_open, b3.is_open, b2.is_open, b1.is_open, b0.is_open}
    let b_actok: bit[8] = {b7.act_ok, b6.act_ok, b5.act_ok, b4.act_ok, b3.act_ok, b2.act_ok, b1.act_ok, b0.act_ok}
    let b_casok: bit[8] = {b7.cas_ok, b6.cas_ok, b5.cas_ok, b4.cas_ok, b3.cas_ok, b2.cas_ok, b1.cas_ok, b0.cas_ok}
    let b_preok: bit[8] = {b7.pre_ok, b6.pre_ok, b5.pre_ok, b4.pre_ok, b3.pre_ok, b2.pre_ok, b1.pre_ok, b0.pre_ok}
    let req_row_open: bit[17] = match req_ba {
        0 => b0.row,
        1 => b1.row,
        2 => b2.row,
        3 => b3.row,
        4 => b4.row,
        5 => b5.row,
        6 => b6.row,
        _ => b7.row
    }
    let tr_row_open: bit[17] = match tr_addr[8:6] {
        0 => b0.row,
        1 => b1.row,
        2 => b2.row,
        3 => b3.row,
        4 => b4.row,
        5 => b5.row,
        6 => b6.row,
        _ => b7.row
    }
    let q_open: bit = b_open[rq_ba]
    // the request's row is the one open in its bank: worked out when the request is taken, and
    // set when its ACT goes out (an ACT is the only command that changes a bank's row)
    let q_hit: bit = if q_open == 1 && rq_rowm == 1 { 1 } else { 0 }
    let faw_ok: bit = match fp {
        0 => fz0,
        1 => fz1,
        2 => fz2,
        _ => fz3
    }

    // ------------------------------------------------------------ what to send this cycle
    let quiet: bit = if rdr_z == 1 && wrr_z == 1 && tq_z == 1 && wq_z == 1 { 1 } else { 0 }
    let idle: bit = if st == 13 { 1 } else { 0 }
    let can_cmd: bit = cmd_z
    let upd_go: bit = if idle == 1 && dfi_phyupd_req == 1 && rq_v == 0 && quiet == 1 { 1 } else { 0 }
    let ref_go: bit = if idle == 1 && ref_due == 1 && upd_go == 0 { 1 } else { 0 }
    // write DQ training goes through the request path (refresh waits until it is over), and so
    // does VREF training (which refreshes between codes)
    let wdq_st: bit = if st == 19 { 1 } else { 0 }
    let vr_st: bit = if st == 20 { 1 } else { 0 }
    // a PHY update is only granted with no request held (upd_go needs rq_v == 0), so it never
    // stops one being served: the condition leaves it out to keep the command choice shallow
    let serve: bit = if ((idle == 1 && ref_due == 0) || wdq_st == 1 || vr_st == 1) && rq_v == 1 && can_cmd == 1 { 1 } else { 0 }
    let do_cas: bit = if serve == 1 && q_hit == 1 && b_casok[rq_ba] == 1 && ((rq_w == 1 && wr_z == 1 && wq_room == 1) || (rq_w == 0 && rd_z == 1 && tq_room == 1)) { 1 } else { 0 }
    let do_pre: bit = if serve == 1 && q_open == 1 && q_hit == 0 && b_preok[rq_ba] == 1 { 1 } else { 0 }
    let do_act: bit = if serve == 1 && q_open == 0 && b_actok[rq_ba] == 1 && actg_z == 1 && faw_ok == 1 { 1 } else { 0 }
    let do_wr: bit = if do_cas == 1 && rq_w == 1 { 1 } else { 0 }
    let do_rd: bit = if do_cas == 1 && rq_w == 0 { 1 } else { 0 }
    // the same commands as strobes for each bank: do_wr && rq_ba == k and so on, from bank k's
    // own flags, with no choice of bank in front of its timers
    let cas_w: bit = if serve == 1 && rq_rowm == 1 && rq_w == 1 && wr_z == 1 && wq_room == 1 { 1 } else { 0 }
    let cas_r: bit = if serve == 1 && rq_rowm == 1 && rq_w == 0 && rd_z == 1 && tq_room == 1 { 1 } else { 0 }
    let act_q: bit = if serve == 1 && actg_z == 1 && faw_ok == 1 { 1 } else { 0 }
    let pre_q: bit = if serve == 1 && rq_rowm == 0 { 1 } else { 0 }
    let cas_k: bit[8] = rq_sel & b_open & b_casok
    let bk_wr: bit[8] = if cas_w == 1 { cas_k } else { 8'h00 }
    let bk_rd: bit[8] = if cas_r == 1 { cas_k } else { 8'h00 }
    let bk_act: bit[8] = if act_q == 1 { rq_sel & ~b_open & b_actok } else { 8'h00 }
    // refresh: precharge all once every bank may close, then REF tRP later (VREF training closes
    // the banks before each MR14 write the same way)
    let vr_close: bit = if vr_st == 1 && vr_ph == 0 { 1 } else { 0 }
    let do_preab: bit = if (st == 14 || vr_close == 1) && can_cmd == 1 && b_preok == 8'hFF && b_open != 0 { 1 } else { 0 }
    let bk_pre: bit[8] = if do_preab == 1 { 8'hFF } else { if pre_q == 1 { rq_sel & b_open & b_preok } else { 8'h00 } }
    let vr_ref: bit = if vr_st == 1 && vr_ph == 1 && ref_due == 1 { 1 } else { 0 }
    let do_ref: bit = if (st == 15 || vr_ref == 1) && can_cmd == 1 && t_ref == 0 { 1 } else { 0 }
    let do_mrw: bit = if st == 4 && can_cmd == 1 && mi < 12 { 1 } else { 0 }
    // VREF training's MR14 writes
    let do_vrmrw: bit = if vr_st == 1 && vr_ph == 2 && can_cmd == 1 { 1 } else { 0 }
    // the level as MR14: range 0 up to level 75, range 1 above
    let vr_c0: bit[7] = vr_c - 25
    let vr_c1: bit[7] = vr_c - 55
    let vr_op: bit[8] = if vr_keep == 1 { mr14_c } else { if vr_c <= 75 { {mr14_c[7], 1'b0, vr_c0[5:0]} } else { {mr14_c[7], 1'b1, vr_c1[5:0]} } }
    // the next level, and the best run once this level's result is in
    let vr_nxt: bit[7] = vr_c + vr_step7
    let vr_last: bit = if vr_nxt > vr_hi7 { 1 } else { 0 }
    let vr_pass: bit = if vr_bad == 0 { 1 } else { 0 }
    let vr_rs_n: bit[7] = if vr_cl == 0 { vr_c } else { vr_rs }
    let vr_cl_n: bit[7] = vr_cl + 1
    let vr_better: bit = if vr_pass == 1 && vr_cl_n > vr_bl { 1 } else { 0 }
    let vr_bs_n: bit[7] = if vr_better == 1 { vr_rs_n } else { vr_bs }
    let vr_be_n: bit[7] = if vr_better == 1 { vr_c } else { vr_be }
    let vr_bl_n: bit[7] = if vr_better == 1 { vr_cl_n } else { vr_bl }
    let vr_sum: bit[8] = {1'b0, vr_bs_n} + {1'b0, vr_be_n}
    let vr_mid: bit[7] = vr_sum[7:1]
    // this code's reads are all back and judged
    let vr_judge: bit = if vr_st == 1 && vr_ph == 5 && rq_v == 0 && quiet == 1 && vr_got == vr_nrd { 1 } else { 0 }
    // this code's requests: three writes, then the three reads, TRAIN_ADDR's column and the
    // two below it
    let vr_ci: bit[3] = if vr_k < 3 { vr_k } else { vr_k - 3 }
    // MR2 with WR-LEV set (in) and clear (out)
    let do_wlmrw: bit = if st == 18 && can_cmd == 1 && (wl_ph == 0 || wl_ph == 3) { 1 } else { 0 }
    let wl_mr2: bit[8] = if wl_ph == 0 { mr2_c | 8'h80 } else { mr2_c }
    let wl_done: bit = if dfi_wrlvl_resp == 2'b11 { 1 } else { 0 }
    let do_strobe: bit = if st == 18 && wl_ph == 2 && wl_done == 0 && train_gap == 0 && train_reads < wl_max { 1 } else { 0 }
    let wdq_done: bit = if dfi_wdqlvl_resp == 2'b11 { 1 } else { 0 }
    let do_zqs: bit = if st == 5 && can_cmd == 1 { 1 } else { 0 }
    let do_zql: bit = if st == 7 && wait_c == 0 { 1 } else { 0 }
    let do_mrr: bit = if st == 8 && can_cmd == 1 && mi < 2 { 1 } else { 0 }
    let training: bit = if st == 10 || st == 11 { 1 } else { 0 }
    let lvl_done: bit = if (st == 10 && dfi_rdlvl_gate_resp == 2'b11) || (st == 11 && dfi_rdlvl_resp == 2'b11) { 1 } else { 0 }
    // training reads stop for a refresh; one goes in once the gap since the last has passed
    let train_ref: bit = if training == 1 && ref_due == 1 && can_cmd == 1 && actg_z == 1 && train_gap == 0 { 1 } else { 0 }
    let do_rdc: bit = if training == 1 && lvl_done == 0 && train_ref == 0 && can_cmd == 1 && train_gap == 0 && train_reads < tr_max { 1 } else { 0 }

    let mrw_ma: bit[6] = match mi {
        0 => 13,
        1 => 1,
        2 => 2,
        3 => 3,
        4 => 11,
        5 => 12,
        6 => 14,
        7 => 22,
        8 => 15,
        9 => 20,
        10 => 32,
        _ => 40
    }
    let mrw_op: bit[8] = match mi {
        0 => mr13_c,
        1 => mr1_c,
        2 => mr2_c,
        3 => mr3_c,
        4 => mr11_c,
        5 => mr12_c,
        6 => mr14_c,
        7 => mr22_c,
        8 => mr15_c,
        9 => mr20_c,
        10 => mr32_c,
        _ => mr40_c
    }
    let mrr_ma: bit[6] = if mi == 0 { 5 } else { 8 }
    let four: bit = if do_act == 1 || do_cas == 1 || do_mrw == 1 || do_wlmrw == 1 || do_vrmrw == 1 || do_mrr == 1 || do_rdc == 1 { 1 } else { 0 }
    let two: bit = if do_pre == 1 || do_preab == 1 || do_ref == 1 || train_ref == 1 || do_zqs == 1 || do_zql == 1 { 1 } else { 0 }
    let f_cs: bit[4] = if four == 1 { 4'b0101 } else { if two == 1 { 4'b0001 } else { 4'b0000 } }
    let f_ca: bit[24] =
        if do_act == 1 { ca_act(rq_row, rq_ba) }
        else { if do_wr == 1 { ca_cas(5'b00100, rq_ba, rq_col) }
        else { if do_rd == 1 { ca_cas(5'b00010, rq_ba, rq_col) }
        else { if do_mrw == 1 { ca_mrw(mrw_ma, mrw_op) }
        else { if do_wlmrw == 1 { ca_mrw(6'd2, wl_mr2) }
        else { if do_vrmrw == 1 { ca_mrw(6'd14, vr_op) }
        else { if do_mrr == 1 { ca_mrr(mrr_ma) }
        else { if do_rdc == 1 { ca_mpc(7'h43) }
        else { if do_pre == 1 { {18'h00000, 3'b000, rq_ba, 6'b010000} }
        else { if do_preab == 1 { {18'h00000, 6'b000000, 6'b110000} }
        else { if do_ref == 1 || train_ref == 1 { {18'h00000, 6'b000000, 6'b101000} }
        else { if do_zqs == 1 { {18'h00000, 6'd15, 6'b100000} }
        else { if do_zql == 1 { {18'h00000, 6'd17, 6'b100000} }
        else { 24'h000000 } } } } } } } } } } } } }

    // ------------------------------------------------------------ data enables
    let rd_issue: bit = if do_rd == 1 || do_mrr == 1 || do_rdc == 1 { 1 } else { 0 }
    let wr_mod: bit[64] = if do_wr == 1 { wr_ring | wr_mask } else { wr_ring }
    let rd_mod: bit[64] = if rd_issue == 1 { rd_ring | rd_mask } else { rd_ring }
    // whether each ring is empty after this cycle's shift, with and without a new burst
    let wr_hi_z: bit = if (wr_ring >> 4) == 0 { 1 } else { 0 }
    let wrm_hi_z: bit = if ((wr_ring | wr_mask) >> 4) == 0 { 1 } else { 0 }
    let rd_hi_z: bit = if (rd_ring >> 4) == 0 { 1 } else { 0 }
    let rdm_hi_z: bit = if ((rd_ring | rd_mask) >> 4) == 0 { 1 } else { 0 }
    // Each slot carries its word of the burst from the cycle the write was issued, so no count
    // runs through the frame: a slot after the head burst's last word takes the next burst.
    let wb_mod: bit[192] = if do_wr == 1 { wb_ring | wb_mask } else { wb_ring }
    let wb0: bit[3] = wb_mod[2:0]
    let wb1: bit[3] = wb_mod[5:3]
    let wb2: bit[3] = wb_mod[8:6]
    let wb3: bit[3] = wb_mod[11:9]
    let wend0: bit = if wr_mod[0] == 1 && wb0 == 7 { 1 } else { 0 }
    let wend1: bit = if wr_mod[1] == 1 && wb1 == 7 { 1 } else { 0 }
    let wend2: bit = if wr_mod[2] == 1 && wb2 == 7 { 1 } else { 0 }
    let wend3: bit = if wr_mod[3] == 1 && wb3 == 7 { 1 } else { 0 }
    let wd_head: bit[256] = wq[wq_rp]
    let wd_next: bit[256] = wq[wq_rp1]
    let wd0: bit[32] = burst_word(wd_head, wb0)
    let wd1: bit[32] = if wend0 == 1 { burst_word(wd_next, wb1) } else { burst_word(wd_head, wb1) }
    let wd2: bit[32] = if wend0 == 1 || wend1 == 1 { burst_word(wd_next, wb2) } else { burst_word(wd_head, wb2) }
    let wd3: bit[32] = if wend0 == 1 || wend1 == 1 || wend2 == 1 { burst_word(wd_next, wb3) } else { burst_word(wd_head, wb3) }
    let w_pop: bit = if wend0 == 1 || wend1 == 1 || wend2 == 1 || wend3 == 1 { 1 } else { 0 }

    // ------------------------------------------------------------ read data in
    // The PHY's words, valid ones packed to the front before they are registered: word i
    // goes to the place counting the valid words before it.
    let iv0: bit = dfi_rddata_valid_w0
    let iv1: bit = dfi_rddata_valid_w1
    let iv2: bit = dfi_rddata_valid_w2
    let iv3: bit = dfi_rddata_valid_w3
    let ik1: bit[2] = {1'b0, iv0}
    let ik2: bit[2] = {1'b0, iv0} + {1'b0, iv1}
    let pk0: bit[32] = if iv0 == 1 { dfi_rddata_w0 } else { if iv1 == 1 { dfi_rddata_w1 } else { if iv2 == 1 { dfi_rddata_w2 } else { dfi_rddata_w3 } } }
    let pk1: bit[32] = if iv1 == 1 && ik1 == 1 { dfi_rddata_w1 } else { if iv2 == 1 && ik2 == 1 { dfi_rddata_w2 } else { dfi_rddata_w3 } }
    let pk2: bit[32] = if iv2 == 1 && ik2 == 2 { dfi_rddata_w2 } else { dfi_rddata_w3 }
    let pk3: bit[32] = dfi_rddata_w3
    let pk_n: bit[3] = {2'b00, iv0} + {2'b00, iv1} + {2'b00, iv2} + {2'b00, iv3}
    // The registered words are already packed (valid ones first, r_n of them), so each slot of
    // the burst being assembled takes word (slot - rc) when that is below r_n.
    let rtot: bit[4] = rc + {1'b0, r_n}
    let r_emit: bit = if rtot >= 8 { 1 } else { 0 }
    let rd0: bit[4] = 0 - rc
    let rf0: bit = if rd0 < {1'b0, r_n} { 1 } else { 0 }
    let rp0: bit[32] = rsel(ri0, ri1, ri2, ri3, rd0[1:0])
    let rd1: bit[4] = 1 - rc
    let rf1: bit = if rd1 < {1'b0, r_n} { 1 } else { 0 }
    let rp1: bit[32] = rsel(ri0, ri1, ri2, ri3, rd1[1:0])
    let rd2: bit[4] = 2 - rc
    let rf2: bit = if rd2 < {1'b0, r_n} { 1 } else { 0 }
    let rp2: bit[32] = rsel(ri0, ri1, ri2, ri3, rd2[1:0])
    let rd3: bit[4] = 3 - rc
    let rf3: bit = if rd3 < {1'b0, r_n} { 1 } else { 0 }
    let rp3: bit[32] = rsel(ri0, ri1, ri2, ri3, rd3[1:0])
    let rd4: bit[4] = 4 - rc
    let rf4: bit = if rd4 < {1'b0, r_n} { 1 } else { 0 }
    let rp4: bit[32] = rsel(ri0, ri1, ri2, ri3, rd4[1:0])
    let rd5: bit[4] = 5 - rc
    let rf5: bit = if rd5 < {1'b0, r_n} { 1 } else { 0 }
    let rp5: bit[32] = rsel(ri0, ri1, ri2, ri3, rd5[1:0])
    let rd6: bit[4] = 6 - rc
    let rf6: bit = if rd6 < {1'b0, r_n} { 1 } else { 0 }
    let rp6: bit[32] = rsel(ri0, ri1, ri2, ri3, rd6[1:0])
    let rd7: bit[4] = 7 - rc
    let rf7: bit = if rd7 < {1'b0, r_n} { 1 } else { 0 }
    let rp7: bit[32] = rsel(ri0, ri1, ri2, ri3, rd7[1:0])
    let rd8: bit[4] = 8 - rc
    let rf8: bit = if rd8 < {1'b0, r_n} { 1 } else { 0 }
    let rp8: bit[32] = rsel(ri0, ri1, ri2, ri3, rd8[1:0])
    let rd9: bit[4] = 9 - rc
    let rf9: bit = if rd9 < {1'b0, r_n} { 1 } else { 0 }
    let rp9: bit[32] = rsel(ri0, ri1, ri2, ri3, rd9[1:0])
    let rd10: bit[4] = 10 - rc
    let rf10: bit = if rd10 < {1'b0, r_n} { 1 } else { 0 }
    let rp10: bit[32] = rsel(ri0, ri1, ri2, ri3, rd10[1:0])
    let rd11: bit[4] = 11 - rc
    let rf11: bit = if rd11 < {1'b0, r_n} { 1 } else { 0 }
    let rp11: bit[32] = rsel(ri0, ri1, ri2, ri3, rd11[1:0])
    let rd12: bit[4] = 12 - rc
    let rf12: bit = if rd12 < {1'b0, r_n} { 1 } else { 0 }
    let rp12: bit[32] = rsel(ri0, ri1, ri2, ri3, rd12[1:0])
    let rd13: bit[4] = 13 - rc
    let rf13: bit = if rd13 < {1'b0, r_n} { 1 } else { 0 }
    let rp13: bit[32] = rsel(ri0, ri1, ri2, ri3, rd13[1:0])
    let rd14: bit[4] = 14 - rc
    let rf14: bit = if rd14 < {1'b0, r_n} { 1 } else { 0 }
    let rp14: bit[32] = rsel(ri0, ri1, ri2, ri3, rd14[1:0])
    let rd15: bit[4] = 15 - rc
    let rf15: bit = if rd15 < {1'b0, r_n} { 1 } else { 0 }
    let rp15: bit[32] = rsel(ri0, ri1, ri2, ri3, rd15[1:0])
    let re0: bit[32] = if rf0 == 1 { rp0 } else { rw0 }
    let re1: bit[32] = if rf1 == 1 { rp1 } else { rw1 }
    let re2: bit[32] = if rf2 == 1 { rp2 } else { rw2 }
    let re3: bit[32] = if rf3 == 1 { rp3 } else { rw3 }
    let re4: bit[32] = if rf4 == 1 { rp4 } else { rw4 }
    let re5: bit[32] = if rf5 == 1 { rp5 } else { rw5 }
    let re6: bit[32] = if rf6 == 1 { rp6 } else { rw6 }
    let re7: bit[32] = if rf7 == 1 { rp7 } else { rw7 }
    let rn0: bit[32] = if r_emit == 1 && rf8 == 1 { rp8 } else { re0 }
    let rn1: bit[32] = if r_emit == 1 && rf9 == 1 { rp9 } else { re1 }
    let rn2: bit[32] = if r_emit == 1 && rf10 == 1 { rp10 } else { re2 }
    let rn3: bit[32] = if r_emit == 1 && rf11 == 1 { rp11 } else { re3 }
    let rn4: bit[32] = if r_emit == 1 && rf12 == 1 { rp12 } else { re4 }
    let rn5: bit[32] = if r_emit == 1 && rf13 == 1 { rp13 } else { re5 }
    let rn6: bit[32] = if r_emit == 1 && rf14 == 1 { rp14 } else { re6 }
    let rn7: bit[32] = if r_emit == 1 && rf15 == 1 { rp15 } else { re7 }
    let r_burst: bit[256] = {re7, re6, re5, re4, re3, re2, re1, re0}
    let r_tag: bit[2] = tq[tq_rp]
    // write DQ training reads are checked by the PHY and return nothing
    let tq_push: bit = if (do_rd == 1 && wdq_st == 0) || do_mrr == 1 { 1 } else { 0 }

    // ------------------------------------------------------------ banks
    inst b0 = Lpddr4BankState {
        clk: clk,
        act: bk_act[0],
        pre: bk_pre[0],
        rd: bk_rd[0],
        wr: bk_wr[0],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }
    inst b1 = Lpddr4BankState {
        clk: clk,
        act: bk_act[1],
        pre: bk_pre[1],
        rd: bk_rd[1],
        wr: bk_wr[1],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }
    inst b2 = Lpddr4BankState {
        clk: clk,
        act: bk_act[2],
        pre: bk_pre[2],
        rd: bk_rd[2],
        wr: bk_wr[2],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }
    inst b3 = Lpddr4BankState {
        clk: clk,
        act: bk_act[3],
        pre: bk_pre[3],
        rd: bk_rd[3],
        wr: bk_wr[3],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }
    inst b4 = Lpddr4BankState {
        clk: clk,
        act: bk_act[4],
        pre: bk_pre[4],
        rd: bk_rd[4],
        wr: bk_wr[4],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }
    inst b5 = Lpddr4BankState {
        clk: clk,
        act: bk_act[5],
        pre: bk_pre[5],
        rd: bk_rd[5],
        wr: bk_wr[5],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }
    inst b6 = Lpddr4BankState {
        clk: clk,
        act: bk_act[6],
        pre: bk_pre[6],
        rd: bk_rd[6],
        wr: bk_wr[6],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }
    inst b7 = Lpddr4BankState {
        clk: clk,
        act: bk_act[7],
        pre: bk_pre[7],
        rd: bk_rd[7],
        wr: bk_wr[7],
        row_in: rq_row,
        f_rcd: f_rcd,
        f_ras: f_ras,
        f_rp: f_rp,
        f_wr: f_wr,
        f_rtp: f_rtp
    }

    on(clk.rise) {
        // ---------------------------------------------------------------- DFI frame out
        o_cs = f_cs
        o_ca = f_ca
        o_we = wr_mod[3:0]
        o_wd = {wd3, wd2, wd1, wd0}
        o_re = rd_mod[3:0]
        wr_ring = wr_mod >> 4
        wb_ring = wb_mod >> 12
        rd_ring = rd_mod >> 4
        if w_pop == 1 {
            wq_rp = wq_rp1
            wq_rp1 = wq_rp1 + 1
        }
        if do_wr == 1 {
            wq[wq_wp] = rq_data
            wq_wp = wq_wp + 1
        }
        wq_n = if do_wr == 1 && w_pop == 0 { wq_n + 1 } else { if do_wr == 0 && w_pop == 1 { wq_n - 1 } else { wq_n } }
        wq_room = if do_wr == 1 && w_pop == 0 { if wq_n < 3 { 1 } else { 0 } } else { if do_wr == 0 && w_pop == 1 { if wq_n < 5 { 1 } else { 0 } } else { if wq_n < 4 { 1 } else { 0 } } }
        wq_z = if do_wr == 1 && w_pop == 0 { 0 } else { if do_wr == 0 && w_pop == 1 { if wq_n == 1 { 1 } else { 0 } } else { if wq_n == 0 { 1 } else { 0 } } }
        wrr_z = if do_wr == 1 { wrm_hi_z } else { wr_hi_z }
        rdr_z = if rd_issue == 1 { rdm_hi_z } else { rd_hi_z }

        // ---------------------------------------------------------------- read data in
        ri0 = pk0
        ri1 = pk1
        ri2 = pk2
        ri3 = pk3
        r_n = pk_n
        rw0 = rn0
        rw1 = rn1
        rw2 = rn2
        rw3 = rn3
        rw4 = rn4
        rw5 = rn5
        rw6 = rn6
        rw7 = rn7
        rc = if r_emit == 1 { rtot - 8 } else { rtot }
        rsp_v_r = 0
        if r_emit == 1 {
            tq_rp = tq_rp + 1
            if r_tag == 0 {
                rsp_v_r = 1
                rsp_d_r = r_burst
            }
            if r_tag == 1 { mr5_r = re0[7:0] }
            if r_tag == 2 { mr8_r = re0[7:0] }
            // VREF training's read-backs, in the order written, compared the next cycle
            if r_tag == 3 {
                vr_rb = r_burst
                vr_rbi = vr_gi
                vr_gi = if vr_gi == 2 { 2'd0 } else { vr_gi + 1 }
            }
        }
        vr_rbv = if r_emit == 1 && r_tag == 3 { 1 } else { 0 }
        if vr_rbv == 1 {
            if vr_rb != vr_pat(vr_rbi) { vr_bad = 1 }
            vr_got = vr_got + 1
        }
        if tq_push == 1 {
            tq[tq_wp] = if do_mrr == 1 { if mi == 0 { 2'd1 } else { 2'd2 } } else { if vr_st == 1 { 2'd3 } else { 2'd0 } }
            tq_wp = tq_wp + 1
        }
        tq_n = if tq_push == 1 && r_emit == 0 { tq_n + 1 } else { if tq_push == 0 && r_emit == 1 { tq_n - 1 } else { tq_n } }
        tq_room = if tq_push == 1 && r_emit == 0 { if tq_n < 7 { 1 } else { 0 } } else { if tq_push == 0 && r_emit == 1 { if tq_n < 9 { 1 } else { 0 } } else { if tq_n < 8 { 1 } else { 0 } } }
        tq_z = if tq_push == 1 && r_emit == 0 { 0 } else { if tq_push == 0 && r_emit == 1 { if tq_n == 1 { 1 } else { 0 } } else { if tq_n == 0 { 1 } else { 0 } } }

        // ---------------------------------------------------------------- timers
        t_cmd = if do_mrw == 1 || do_wlmrw == 1 || do_vrmrw == 1 { m1_mrw } else { if do_zql == 1 { m1_zqlat } else { if do_mrr == 1 { m1_mrr } else { if do_ref == 1 || train_ref == 1 { m1_rfc } else { dec8(t_cmd) } } } }
        t_actg = if do_act == 1 { max8(dec8(t_actg), m1_rrd) } else { if do_ref == 1 { max8(dec8(t_actg), m1_rfc) } else { dec8(t_actg) } }
        t_rd = if do_rd == 1 || do_rdc == 1 || do_mrr == 1 { max8(dec8(t_rd), m1_ccd) } else { if do_wr == 1 { max8(dec8(t_rd), m1_wtr) } else { dec8(t_rd) } }
        t_wr = if do_wr == 1 { max8(dec8(t_wr), m1_ccd) } else { if do_rd == 1 || do_rdc == 1 || do_mrr == 1 { max8(dec8(t_wr), m1_rtw) } else { dec8(t_wr) } }
        t_ref = if do_preab == 1 || do_pre == 1 { max8(dec8(t_ref), m1_rp) } else { dec8(t_ref) }
        faw0 = if do_act == 1 && fp == 0 { m1_faw } else { dec8(faw0) }
        faw1 = if do_act == 1 && fp == 1 { m1_faw } else { dec8(faw1) }
        faw2 = if do_act == 1 && fp == 2 { m1_faw } else { dec8(faw2) }
        faw3 = if do_act == 1 && fp == 3 { m1_faw } else { dec8(faw3) }
        if do_act == 1 { fp = fp + 1 }
        // max8(dec8(t), m) is 0 exactly when t <= 1 and m is 0
        cmd_z = if do_mrw == 1 || do_wlmrw == 1 || do_vrmrw == 1 { z8(m1_mrw) } else { if do_zql == 1 { z8(m1_zqlat) } else { if do_mrr == 1 { z8(m1_mrr) } else { if do_ref == 1 || train_ref == 1 { z8(m1_rfc) } else { le1(t_cmd) } } } }
        actg_z = if do_act == 1 { le1(t_actg) & z8(m1_rrd) } else { if do_ref == 1 { le1(t_actg) & z8(m1_rfc) } else { le1(t_actg) } }
        rd_z = if do_rd == 1 || do_rdc == 1 || do_mrr == 1 { le1(t_rd) & z8(m1_ccd) } else { if do_wr == 1 { le1(t_rd) & z8(m1_wtr) } else { le1(t_rd) } }
        wr_z = if do_wr == 1 { le1(t_wr) & z8(m1_ccd) } else { if do_rd == 1 || do_rdc == 1 || do_mrr == 1 { le1(t_wr) & z8(m1_rtw) } else { le1(t_wr) } }
        fz0 = if do_act == 1 && fp == 0 { z8(m1_faw) } else { le1(faw0) }
        fz1 = if do_act == 1 && fp == 1 { z8(m1_faw) } else { le1(faw1) }
        fz2 = if do_act == 1 && fp == 2 { z8(m1_faw) } else { le1(faw2) }
        fz3 = if do_act == 1 && fp == 3 { z8(m1_faw) } else { le1(faw3) }

        // ---------------------------------------------------------------- refresh interval
        if ref_on == 1 {
            if refc + 1 >= f_refi {
                refc = 0
                ref_due = 1
            } else {
                refc = refc + 1
            }
        }
        if do_ref == 1 || train_ref == 1 { ref_due = 0 }

        // ---------------------------------------------------------------- the request
        // a pending PHY update stops new requests so the bus drains and the window is granted
        if req_valid == 1 && rq_v == 0 && init_done_r == 1 && dfi_phyupd_req == 0 {
            rq_v = 1
            rq_w = req_write
            rq_row = req_row
            rq_ba = req_ba
            rq_sel = 8'h01 << req_ba
            rq_col = req_col
            rq_data = req_wdata
            rq_rowm = if req_row_open == req_row { 1 } else { 0 }
        }
        if do_act == 1 { rq_rowm = 1 }
        if do_cas == 1 { rq_v = 0 }

        // ---------------------------------------------------------------- sequence
        wait_c = if wait_c == 0 { 0 } else { wait_c - 1 }
        train_gap = if do_rdc == 1 || (do_rd == 1 && wdq_st == 1) { tr_gap } else { if do_strobe == 1 { wl_gap } else { if train_gap == 0 { 0 } else { train_gap - 1 } } }
        if do_rdc == 1 || do_strobe == 1 || (do_rd == 1 && wdq_st == 1) { train_reads = train_reads + 1 }
        wrlvl_strobe_r = do_strobe
        match st {
            0 => {
                init_start_r = 1
                if dfi_init_complete == 1 {
                    st = 1
                    wait_c = i1_cyc
                }
            },
            1 => {
                if wait_c == 0 {
                    st = 2
                    reset_r = 1
                    wait_c = i3_cyc
                }
            },
            2 => {
                if wait_c == 0 {
                    st = 3
                    cke_r = 1
                    wait_c = i5_cyc
                }
            },
            3 => {
                if wait_c == 0 {
                    st = 4
                    mi = 0
                }
            },
            4 => {
                if do_mrw == 1 { mi = mi + 1 }
                if mi == 12 { st = 5 }
            },
            5 => {
                if do_zqs == 1 {
                    st = 6
                    wait_c = f_zqcal32
                }
            },
            6 => {
                if wait_c == 0 { st = 7 }
            },
            7 => {
                if do_zql == 1 {
                    st = 18
                    ref_on = 1
                    wl_ph = 0
                }
            },
            8 => {
                if do_mrr == 1 { mi = mi + 1 }
                if mi == 2 { st = 9 }
            },
            9 => {
                if tq_n == 0 {
                    st = 12
                    wait_c = 4
                }
            },
            10 => {
                if lvl_done == 1 || train_reads >= tr_max {
                    if lvl_done == 0 { train_fail_r = 1 }
                    if quiet == 1 && train_gap == 0 {
                        st = 11
                        gate_en_r = 0
                        rdlvl_en_r = 1
                        train_reads = 0
                    }
                }
            },
            11 => {
                if lvl_done == 1 || train_reads >= tr_max {
                    if lvl_done == 0 { train_fail_r = 1 }
                    if quiet == 1 && train_gap == 0 {
                        st = 19
                        rdlvl_en_r = 0
                        wdqlvl_en_r = 1
                        tw_w = 1
                        train_reads = 0
                    }
                }
            },
            12 => {
                if wait_c == 0 {
                    st = 13
                    init_done_r = 1
                }
            },
            13 => {
                if upd_go == 1 {
                    st = 16
                    phyupd_ack_r = 1
                } else {
                    if ref_go == 1 {
                        st = 14
                    }
                }
            },
            14 => {
                if b_open == 0 {
                    st = 15
                }
            },
            15 => {
                if do_ref == 1 {
                    st = 17
                }
            },
            16 => {
                if dfi_phyupd_req == 0 {
                    st = 13
                    phyupd_ack_r = 0
                }
            },
            18 => {
                match wl_ph {
                    0 => {
                        if do_wlmrw == 1 {
                            wl_ph = 1
                            wait_c = wlmrd32
                        }
                    },
                    1 => {
                        if wait_c == 0 {
                            wl_ph = 2
                            wrlvl_en_r = 1
                            train_reads = 0
                        }
                    },
                    2 => {
                        if wl_done == 1 || train_reads >= wl_max {
                            if wl_done == 0 { train_fail_r = 1 }
                            if train_gap == 0 {
                                wl_ph = 3
                                wrlvl_en_r = 0
                            }
                        }
                    },
                    _ => {
                        if do_wlmrw == 1 {
                            st = 10
                            gate_en_r = 1
                            train_reads = 0
                        }
                    }
                }
            },
            19 => {
                // a write and its read-back in turn until every lane is done; each pair waits
                // TRAIN_GAP_CYC after the last read-back, so the PHY can evaluate it and move
                if rq_v == 0 && wdq_done == 0 && train_reads < tr_max && train_gap == 0 {
                    rq_v = 1
                    rq_w = tw_w
                    rq_row = tr_addr[25:9]
                    rq_ba = tr_addr[8:6]
                    rq_sel = 8'h01 << tr_addr[8:6]
                    rq_col = tr_addr[5:0]
                    rq_data = 0
                    rq_rowm = if tr_row_open == tr_addr[25:9] { 1 } else { 0 }
                    tw_w = ~tw_w
                }
                if (wdq_done == 1 || train_reads >= tr_max) && rq_v == 0 && quiet == 1 && train_gap == 0 {
                    if wdq_done == 0 { train_fail_r = 1 }
                    wdqlvl_en_r = 0
                    mi = 0
                    if vr_on == 1 && vr_done == 0 {
                        st = 20
                        vr_ph = 0
                        vr_c = vr_lo
                        vr_fin = 0
                        vr_keep = 0
                        vr_gi = 0
                        vr_got = 0
                        vr_bad = 0
                        vr_cl = 0
                        vr_bl = 0
                        vr_bs = 0
                        vr_be = 0
                        vr_map = 0
                    } else {
                        st = 8
                    }
                }
            },
            20 => {
                match vr_ph {
                    0 => {
                        if b_open == 0 { vr_ph = 1 }
                    },
                    1 => {
                        if do_ref == 1 || (ref_due == 0 && t_ref == 0) { vr_ph = 2 }
                    },
                    2 => {
                        if do_vrmrw == 1 {
                            vr_ph = 3
                            wait_c = tvref32
                        }
                    },
                    3 => {
                        if wait_c == 0 {
                            if vr_fin == 1 {
                                // write DQ training again, at the chosen reference
                                st = 19
                                vr_done = 1
                                vref_r = vr_op
                                wdqlvl_en_r = 1
                                tw_w = 1
                                train_reads = 0
                            } else {
                                vr_ph = 4
                                vr_k = 0
                                vr_r = 0
                            }
                        }
                    },
                    4 => {
                        if rq_v == 0 {
                            if vr_k < 6 {
                                rq_v = 1
                                rq_w = if vr_k < 3 { 1 } else { 0 }
                                rq_row = tr_addr[25:9]
                                rq_ba = tr_addr[8:6]
                                rq_sel = 8'h01 << tr_addr[8:6]
                                rq_col = tr_addr[5:0] - {3'b000, vr_ci}
                                rq_data = vr_pat(vr_ci[1:0])
                                rq_rowm = if tr_row_open == tr_addr[25:9] { 1 } else { 0 }
                                vr_k = vr_k + 1
                            } else {
                                if vr_r + 1 < vr_reps {
                                    vr_r = vr_r + 1
                                    vr_k = 0
                                } else {
                                    vr_ph = 5
                                }
                            }
                        }
                    },
                    _ => {
                        if vr_judge == 1 {
                            vr_map = {vr_map[62:0], vr_pass}
                            vr_rs = vr_rs_n
                            vr_cl = if vr_pass == 1 { vr_cl_n } else { 0 }
                            vr_bs = vr_bs_n
                            vr_be = vr_be_n
                            vr_bl = vr_bl_n
                            vr_gi = 0
                            vr_got = 0
                            vr_bad = 0
                            vr_ph = 0
                            if vr_last == 1 {
                                vr_fin = 1
                                if vr_bl_n == 0 {
                                    train_fail_r = 1
                                    vr_keep = 1
                                } else {
                                    vr_c = vr_mid
                                }
                            } else {
                                vr_c = vr_nxt
                            }
                        }
                    }
                }
            },
            _ => {
                // controller update after a refresh, once nothing is on the bus (reads
                // issued before the refresh can still be in flight), held CTRLUPD_CYC cycles
                if ctrlupd_r == 0 {
                    if quiet == 1 {
                        ctrlupd_r = 1
                        wait_c = cu_cyc
                    }
                } else {
                    if wait_c == 0 {
                        ctrlupd_r = 0
                        st = 13
                    }
                }
            }
        }
    }

    req_ready = if rq_v == 0 && init_done_r == 1 && dfi_phyupd_req == 0 { 1 } else { 0 }
    rsp_valid = rsp_v_r
    rsp_rdata = rsp_d_r
    init_done = init_done_r
    train_fail = train_fail_r
    mr5 = mr5_r
    mr8 = mr8_r
    state = st
    vref = vref_r
    vref_win = {vr_be, vr_bs}
    vref_map = vr_map
    dfi_init_start = init_start_r
    dfi_ctrlupd_req = ctrlupd_r
    dfi_phyupd_ack = phyupd_ack_r
    dfi_rdlvl_gate_en = gate_en_r
    dfi_rdlvl_en = rdlvl_en_r
    dfi_wrlvl_en = wrlvl_en_r
    dfi_wrlvl_strobe = wrlvl_strobe_r
    dfi_wdqlvl_en = wdqlvl_en_r
    dfi_cs_p0 = o_cs[0]
    dfi_address_p0 = o_ca[5:0]
    dfi_cke_p0 = cke_r
    dfi_reset_n_p0 = reset_r
    dfi_wrdata_en_p0 = o_we[0]
    dfi_wrdata_p0 = o_wd[31:0]
    dfi_wrdata_mask_p0 = 4'b0000
    dfi_rddata_en_p0 = o_re[0]
    dfi_cs_p1 = o_cs[1]
    dfi_address_p1 = o_ca[11:6]
    dfi_cke_p1 = cke_r
    dfi_reset_n_p1 = reset_r
    dfi_wrdata_en_p1 = o_we[1]
    dfi_wrdata_p1 = o_wd[63:32]
    dfi_wrdata_mask_p1 = 4'b0000
    dfi_rddata_en_p1 = o_re[1]
    dfi_cs_p2 = o_cs[2]
    dfi_address_p2 = o_ca[17:12]
    dfi_cke_p2 = cke_r
    dfi_reset_n_p2 = reset_r
    dfi_wrdata_en_p2 = o_we[2]
    dfi_wrdata_p2 = o_wd[95:64]
    dfi_wrdata_mask_p2 = 4'b0000
    dfi_rddata_en_p2 = o_re[2]
    dfi_cs_p3 = o_cs[3]
