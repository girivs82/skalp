// Arithmetic on values known at synthesis: a latency picked by a generic plus
// an adjustment. The sum is a constant, so it needs no carry chain, and the
// mask built from it leaves the enable out of bits it can never set.
entity CarryConstantFold<const MODE: nat = 1, const ADJ: nat = 3> {
    in en: bit
    in x: bit[16]
    out mask: bit[16]
    out sum: bit[16]
}

impl CarryConstantFold {
    let mode: bit[8] = MODE
    let lat: bit[16] = match mode[1:0] {
        0 => 4,
        1 => 6,
        2 => 8,
        _ => 10
    }
    let adj: bit[16] = ADJ
    let off: bit[16] = lat + adj
    let m: bit[16] = 16'h00FF << off[3:0]
    mask = if en == 1 { m } else { 16'h0000 }
    sum = x + off
}

entity CarryConstantFoldTop {
    in en: bit
    in x: bit[16]
    out mask: bit[16]
    out sum: bit[16]
}

impl CarryConstantFoldTop {
    inst u = CarryConstantFold<1, 3> { en: en, x: x }
    mask = u.mask
    sum = u.sum
}
