// LPDDR4 controller + Nexus DFI PHY (built from the device family's DDR primitives) + LPDDR4
// channel model, with the traffic generator of lpddr4_dfi_sim.sk.
//
// The top input sim_tick is the simulation tick (117.1875 ps, which the primitive models also
// run on); the edge clock is sim_tick / 16 (533 MHz, 1066 Mbps), the DFI clock the PHY's
// ECLKDIV /4. The channel model runs on sim_tick, so its skews are in ticks (16 per tCK). The
// pads resolve the DRAM's drive, else the PHY's, else 0; the PHY reads every pad back.
use skalp::memory::lpddr4_dfi_controller::Lpddr4DfiController;
use skalp::memory::dfi_lpddr4_nexus_phy::DfiLpddr4NexusPhy;
use skalp::memory::lpddr4_model::Lpddr4ChannelModel;

// 16 beats from the burst number and the pass
fn pattern(i: bit[16], pass: bit[8]) -> bit[256] {
    let s: bit[16] = (i * 16'h9E37) ^ {pass, pass}
    return {s ^ 16'hF00F, s ^ 16'h0FF0, s ^ 16'hAAAA, s ^ 16'h5555, s ^ 16'h3333, s ^ 16'hCCCC, s ^ 16'h1234, s ^ 16'h8421,
            ~s, s ^ 16'h00FF, s ^ 16'hFF00, s ^ 16'h0F0F, s ^ 16'hF0F0, s ^ 16'h6996, s ^ 16'h9669, s}
}

// address of burst i: bank i[2:0], column i[8:3], a row that changes with i
fn burst_addr(i: bit[16]) -> bit[26] {
    let row: bit[17] = {9'h000, i[7:0] ^ 8'h5A}
    return {row, i[2:0], i[8:3]}
}

entity Lpddr4DfiNexusSim<
    const DQSCK_CLKS: nat = 0,
    const DQ_SKEW_CLKS: nat = 0,
    const N_BURSTS: nat = 64,
    const N_PASSES: nat = 2,
    const WR_SKEW0_CLKS: nat = 0,
    const WR_SKEW1_CLKS: nat = 0,
    const WR_DQ_SKEW0_CLKS: nat = 0,
    const WR_DQ_SKEW1_CLKS: nat = 0,
    // simulation ticks (117.1875 ps) per edge clock (= tCK); even. 16: 1066 Mbps
    const CK_TICKS: nat = 16,
    // board delay of CK, CA, CS and CKE behind the PHY's pins, in ticks (at most 64); a whole
    // tCK of it needs the controller's write data a slot later (WR_ADJ = 4)
    const CA_LATE_TICKS: nat = 0,
    // the controller's TPHY_WRLAT_ADJ
    const WR_ADJ: nat = 3,
    // ticks the DQ drivers take to turn on at the pins after the PHY's output enable (at most
    // 64); they turn off at once. An undriven DQ reads 0 (the DRAM's ODT pulls it low)
    const DQ_OE_LATE_TICKS: nat = 0,
    // the MR14 levels the DRAM's write receivers work at (0.4 % of VDDQ steps; the controller's
    // VREF training sweeps levels 25 to 105, both MR14 ranges)
    const VREF_OK_LO: nat = 0,
    const VREF_OK_HI: nat = 255,
    // the controller's VREF training rounds per level
    const VREF_REPS: nat = 1,
    // the PHY's write per-bit deskew (BIT_DESKEW)
    const BIT_DESKEW: nat = 0,
    // the PHY's DQS output delay (DQS_OUT_DELAY)
    const DQS_OUT_DELAY: nat = 0,
    // the PHY's automatic DQS output delay (DQS_AUTO)
    const DQS_AUTO: nat = 0,
    // board delay of the DQ pins in DQ_LATE_MASK (bit k: DQ k) behind the others, on writes, in
    // ticks (at most 64)
    const DQ_LATE_MASK: nat = 0,
    const DQ_LATE_TICKS: nat = 0,
    // a read gate sweep miss: the DRAM's burst for gate training read GATE_MISS (from 1) reaches
    // lane 0 with DQ0 inverted, so that setting fails; 0: none
    const GATE_MISS: nat = 0
> {
    in sim_tick: clock
    out done: bit
    out passes: bit[8]
    out mismatches: bit[32]
    out reads_ok: bit[32]
    out gen_state: bit[3]
    out init_done: bit
    out train_fail: bit
    out ctrl_state: bit[5]
    out mr5: bit[8]
    out mr8: bit[8]
    out gate0: bit[8]
    out gate1: bit[8]
    out rdly0: bit[8]
    out rdly1: bit[8]
    out lvl_fail: bit[2]
    out wl0: bit[8]
    out wl1: bit[8]
    out wdq0: bit[8]
    out wdq1: bit[8]
    out gate_fail: bit[2]
    out dll_lock: bit
    out bursts0: bit[16]
    out bursts1: bit[16]
    out wrlvl_fail: bit[2]
    out wdq_fail: bit[2]
    out ctrlupd_count: bit[16]
    out phyupd_count: bit[8]
    out m_errors: bit[16]
    out m_err_code: bit[8]
    out m_err_cycle: bit[32]
    out m_contention: bit[16]
    out m_dq_viol: bit[16]
    // at the end of training
    out m_dq_viol_init: bit[16]
    out m_n_wr_init: bit[32]
    out m_aliased: bit[16]
    out m_unwritten: bit[16]
    out m_n_act: bit[32]
    out m_n_wr: bit[32]
    out m_n_rd: bit[32]
    out m_n_mrw: bit[16]
    out m_n_mrr: bit[16]
    out m_n_ref: bit[32]
    out m_n_zq: bit[16]
    out m_t_ck: bit[8]
    out vref: bit[8]
    out vref_win: bit[14]
    out wl_relevels: bit[2]
    out vref_map: bit[64]
    out bit_pos0: bit[64]
    out bit_pos1: bit[64]
    out bit_fail0: bit[8]
    out dqs0: bit[8]
    out dqs1: bit[8]
    out bit_fail1: bit[8]
    out gate_map0: bit[64]
}

impl Lpddr4DfiNexusSim {
    // ------------------------------------------------------------ traffic (DFI clock)
    // 0 wait for init, 1 write all, 2 read all, 3 rewrite one, 4 read it back, 5 done
    signal g_st: bit[3] = 0
    signal g_i: bit[16] = 0
    signal g_pass: bit[8] = 0
    signal g_exp: bit[16] = 0
    // the read being checked: its burst, and its place in the pass (phase-2 reads carry the
    // pass's data, phase-4 reads the rewritten data of the next pass)
    signal chk_n: bit[16] = 0
    signal chk_pass: bit[8] = 0
    signal g_wait: bit = 0
    signal mism: bit[32] = 0
    signal rd_ok: bit[32] = 0
    signal passes_r: bit[8] = 0
    signal done_r: bit = 0
    signal snap: bit = 0
    signal viol_init: bit[16] = 0
    signal nwr_init: bit[32] = 0

    let n_bursts: bit[16] = N_BURSTS
    let n_passes: bit[8] = N_PASSES
    let last_i: bit = if g_i + 1 == n_bursts { 1 } else { 0 }
    let g_valid: bit = if (g_st == 1 || g_st == 2 || g_st == 3 || g_st == 4) && g_wait == 0 { 1 } else { 0 }
    let g_write: bit = if g_st == 1 || g_st == 3 { 1 } else { 0 }
    // the rewrite phase uses the next pass number's data
    let g_data_pass: bit[8] = if g_st == 3 { g_pass + 1 } else { g_pass }
    let fire: bit = if g_valid == 1 && ctrl.req_ready == 1 { 1 } else { 0 }
    let exp_pass: bit[8] = if chk_n >= n_bursts { chk_pass + 1 } else { chk_pass }
    let exp_data: bit[256] = pattern(g_exp, exp_pass)

    inst ctrl = Lpddr4DfiController<20, 9, 49, 0, 114, 32, 114, 0, 20, 40, 10,
        10, 12, 23, 6, 22, 70, 2080, 10, 8, 8, 10, 534, 16, 2, 2, WR_ADJ, 3, 32, 80, 8, 40, 32, 64, 63,
        0, 0, 90, 60, 1, 25, 105, 2, VREF_REPS> {
        clk: phy.dfi_clk,
        req_valid: g_valid,
        req_write: g_write,
        req_addr: burst_addr(g_i),
        req_wdata: pattern(g_i, g_data_pass),
        dfi_rddata_w0: phy.dfi_rddata_w0,
        dfi_rddata_w1: phy.dfi_rddata_w1,
        dfi_rddata_w2: phy.dfi_rddata_w2,
        dfi_rddata_w3: phy.dfi_rddata_w3,
        dfi_rddata_valid_w0: phy.dfi_rddata_valid_w0,
        dfi_rddata_valid_w1: phy.dfi_rddata_valid_w1,
        dfi_rddata_valid_w2: phy.dfi_rddata_valid_w2,
        dfi_rddata_valid_w3: phy.dfi_rddata_valid_w3,
        dfi_init_complete: phy.dfi_init_complete,
        dfi_ctrlupd_ack: phy.dfi_ctrlupd_ack,
        dfi_phyupd_req: phy.dfi_phyupd_req,
        dfi_rdlvl_gate_resp: phy.dfi_rdlvl_gate_resp,
        dfi_rdlvl_resp: phy.dfi_rdlvl_resp,
        dfi_wrlvl_resp: phy.dfi_wrlvl_resp,
        dfi_wdqlvl_resp: phy.dfi_wdqlvl_resp
    }

    // edge clock: sim_tick / CK_TICKS
    let tk_half: bit[8] = CK_TICKS / 2 - 1
    let tk_last: bit[8] = CK_TICKS - 1
    signal tk: bit[8] = 0
    signal ek: bit = 0
    on(sim_tick.rise) {
        tk = if tk == tk_last { 0 } else { tk + 1 }
        if tk == tk_half || tk == tk_last {
            ek = !ek
        }
    }
    signal eclk: clock
    eclk = ek
    // the PHY's free-running sync clock: sim_tick / 64 (133 MHz)
    signal sk_n: bit[6] = 0
    on(sim_tick.rise) {
        sk_n = sk_n + 1
    }
    signal sync_clk: clock
    sync_clk = sk_n[5]

    inst phy = DfiLpddr4NexusPhy<BIT_DESKEW: BIT_DESKEW, DQS_OUT_DELAY: DQS_OUT_DELAY, DQS_AUTO: DQS_AUTO> {
        eclk: eclk,
        pll_lock: 1,
        sync_clk: sync_clk,
        dfi_cs_p0: ctrl.dfi_cs_p0,
        dfi_cs_p1: ctrl.dfi_cs_p1,
        dfi_cs_p2: ctrl.dfi_cs_p2,
        dfi_cs_p3: ctrl.dfi_cs_p3,
        dfi_address_p0: ctrl.dfi_address_p0,
        dfi_address_p1: ctrl.dfi_address_p1,
        dfi_address_p2: ctrl.dfi_address_p2,
        dfi_address_p3: ctrl.dfi_address_p3,
        dfi_cke_p0: ctrl.dfi_cke_p0,
        dfi_cke_p1: ctrl.dfi_cke_p1,
        dfi_cke_p2: ctrl.dfi_cke_p2,
        dfi_cke_p3: ctrl.dfi_cke_p3,
        dfi_reset_n_p0: ctrl.dfi_reset_n_p0,
        dfi_reset_n_p1: ctrl.dfi_reset_n_p1,
        dfi_reset_n_p2: ctrl.dfi_reset_n_p2,
        dfi_reset_n_p3: ctrl.dfi_reset_n_p3,
        dfi_wrdata_en_p0: ctrl.dfi_wrdata_en_p0,
        dfi_wrdata_en_p1: ctrl.dfi_wrdata_en_p1,
        dfi_wrdata_en_p2: ctrl.dfi_wrdata_en_p2,
        dfi_wrdata_en_p3: ctrl.dfi_wrdata_en_p3,
        dfi_wrdata_p0: ctrl.dfi_wrdata_p0,
        dfi_wrdata_p1: ctrl.dfi_wrdata_p1,
        dfi_wrdata_p2: ctrl.dfi_wrdata_p2,
        dfi_wrdata_p3: ctrl.dfi_wrdata_p3,
        dfi_wrdata_mask_p0: ctrl.dfi_wrdata_mask_p0,
        dfi_wrdata_mask_p1: ctrl.dfi_wrdata_mask_p1,
        dfi_wrdata_mask_p2: ctrl.dfi_wrdata_mask_p2,
        dfi_wrdata_mask_p3: ctrl.dfi_wrdata_mask_p3,
        dfi_rddata_en_p0: ctrl.dfi_rddata_en_p0,
        dfi_rddata_en_p1: ctrl.dfi_rddata_en_p1,
        dfi_rddata_en_p2: ctrl.dfi_rddata_en_p2,
        dfi_rddata_en_p3: ctrl.dfi_rddata_en_p3,
        dfi_init_start: ctrl.dfi_init_start,
        dfi_ctrlupd_req: ctrl.dfi_ctrlupd_req,
        dfi_phyupd_ack: ctrl.dfi_phyupd_ack,
        dfi_rdlvl_gate_en: ctrl.dfi_rdlvl_gate_en,
        dfi_rdlvl_en: ctrl.dfi_rdlvl_en,
        dfi_wrlvl_en: ctrl.dfi_wrlvl_en,
        dfi_wrlvl_strobe: ctrl.dfi_wrlvl_strobe,
        dfi_wdqlvl_en: ctrl.dfi_wdqlvl_en,
        dq_i: bus_dq,
        dqs_i: bus_dqs
    }

    // CK and the command pins at the DRAM, CA_LATE_TICKS ticks behind the PHY's pins
    let cmd_pins: bit[9] = {phy.ck_t, phy.cke, phy.cs, phy.ca}
    signal cmd_sh: bit[576] = 0
    on(sim_tick.rise) {
        cmd_sh = {cmd_sh[566:0], cmd_pins}
    }
    let ca_late: bit[16] = CA_LATE_TICKS
    let cmd_sh_at: bit[576] = cmd_sh >> ((ca_late - 1) * 9)
    let cmd_at_dram: bit[9] = if ca_late == 0 { cmd_pins } else { cmd_sh_at[8:0] }

    inst dram = Lpddr4ChannelModel<255, 0, 0, 16, DQSCK_CLKS, DQ_SKEW_CLKS, 10, 12, 23, 6, 22, 70, 10, 2080, 10, 8, 8, 8, 534, 16, WR_SKEW0_CLKS, WR_SKEW1_CLKS, WR_DQ_SKEW0_CLKS, WR_DQ_SKEW1_CLKS, 8, VREF_OK_LO, VREF_OK_HI> {
        clk: sim_tick,
        reset_n: phy.reset_n,
        ck_t: cmd_at_dram[8],
        cke: cmd_at_dram[7],
        cs: cmd_at_dram[6],
        ca: cmd_at_dram[5:0],
        dq_in: bus_dq,
        dq_driven: drv_dq,
        dqs_t_in: bus_dqs,
        dqs_c_in: bus_dqsc,
        dqs_driven: drv_dqs
    }

    signal dclk: clock
    signal bus_dq: bit[16]
    signal bus_dqs: bit[2]
    // the complement strobe pins are the PHY's own (pseudo-differential): the model checks them
    signal bus_dqsc: bit[2]
    dclk = phy.dfi_clk
    // a lane drives when any of its pins does
    signal drv_dq: bit[2]
    signal drv_dqs: bit[2]
    drv_dq = {if phy.dq_t[15:8] != 8'hFF { 1'b1 } else { 1'b0 }, if phy.dq_t[7:0] != 8'hFF { 1'b1 } else { 1'b0 }}
    drv_dqs = ~phy.dqs_t
    // the PHY's DQ output disables (1 = not driven), DQ_OE_LATE_TICKS ticks ago: a pin drives
    // once it has been enabled now and then
    signal dqt_sh: bit[1024] = 0
    on(sim_tick.rise) {
        dqt_sh = {dqt_sh[1007:0], phy.dq_t}
    }
    let oe_late: bit[16] = DQ_OE_LATE_TICKS
    let dqt_sh_at: bit[1024] = dqt_sh >> ((oe_late - 1) * 16)
    let dq_off: bit[16] = if oe_late == 0 { phy.dq_t } else { phy.dq_t | dqt_sh_at[15:0] }
    // the PHY's DQ outputs DQ_LATE_TICKS ticks ago, for the late pins
    signal dqo_sh: bit[1024] = 0
    on(sim_tick.rise) {
        dqo_sh = {dqo_sh[1007:0], phy.dq_o}
    }
    let dq_late: bit[16] = DQ_LATE_TICKS
    let dq_late_mask: bit[16] = DQ_LATE_MASK
    let dqo_sh_at: bit[1024] = dqo_sh >> ((dq_late - 1) * 16)
    let dq_out_b: bit[16] = if dq_late == 0 { phy.dq_o } else { (phy.dq_o & ~dq_late_mask) | (dqo_sh_at[15:0] & dq_late_mask) }
    // the DRAM's bursts during read gate training, counted as each starts
    signal gm_n: bit[16] = 0
    signal gm_oe: bit = 0
    on(sim_tick.rise) {
        gm_oe = dram.dq_oe
        if ctrl.dfi_rdlvl_gate_en == 1 && dram.dq_oe == 1 && gm_oe == 0 {
            gm_n = gm_n + 1
        }
    }
    let gate_miss: bit[16] = GATE_MISS
    let gm_flip: bit = if gate_miss != 0 && gm_n == gate_miss && dram.dq_oe == 1 { 1 } else { 0 }
    bus_dq = {
        if dram.dq_oe == 1 { dram.dq_out[15:8] } else { (dq_out_b[15:8] & ~dq_off[15:8]) },
        if dram.dq_oe == 1 { dram.dq_out[7:0] ^ {7'b0000000, gm_flip} } else { (dq_out_b[7:0] & ~dq_off[7:0]) }
    }
    bus_dqs = {
        if dram.dqs_oe == 1 { dram.dqs_out } else { if phy.dqs_t[1] == 0 { phy.dqs_o[1] } else { 1'b0 } },
        if dram.dqs_oe == 1 { dram.dqs_out } else { if phy.dqs_t[0] == 0 { phy.dqs_o[0] } else { 1'b0 } }
    }
    bus_dqsc = {
        if dram.dqs_oe == 1 { ~dram.dqs_out } else { if phy.dqs_c_t[1] == 0 { phy.dqs_c_o[1] } else { 1'b0 } },
        if dram.dqs_oe == 1 { ~dram.dqs_out } else { if phy.dqs_c_t[0] == 0 { phy.dqs_c_o[0] } else { 1'b0 } }
    }

    on(dclk.rise) {
        g_wait = 0
        // DQ timing violations and writes so far, as training ends
        if ctrl.init_done == 1 && snap == 0 {
            snap = 1
            viol_init = dram.dq_viol
            nwr_init = dram.n_wr
        }
        if g_st == 0 && ctrl.init_done == 1 {
            g_st = 1
            g_i = 0
        }
        if fire == 1 {
            if g_st == 1 {
                g_i = if last_i == 1 { 0 } else { g_i + 1 }
                if last_i == 1 { g_st = 2 }
            }
            if g_st == 2 {
                g_i = if last_i == 1 { 0 } else { g_i + 1 }
                if last_i == 1 { g_st = 3 }
            }
            if g_st == 3 {
                g_st = 4
            }
            if g_st == 4 {
                g_i = if last_i == 1 { 0 } else { g_i + 1 }
                g_st = 3
                if last_i == 1 {
                    g_pass = g_pass + 1
                    passes_r = passes_r + 1
                    g_st = if passes_r + 1 == n_passes { 5 } else { 1 }
                }
            }
        }
        // read data: in request order; reads in phase 2 carry this pass's data, in phase 4
        // the rewritten (next pass) data
        if ctrl.rsp_valid == 1 {
            if ctrl.rsp_rdata == exp_data { rd_ok = rd_ok + 1 } else { mism = mism + 1 }
            g_exp = if g_exp + 1 == n_bursts { 0 } else { g_exp + 1 }
            if chk_n + 1 == n_bursts + n_bursts {
                chk_n = 0
                chk_pass = chk_pass + 1
            } else {
                chk_n = chk_n + 1
            }
        }
        if g_st == 5 && rd_ok + mism == n_bursts * 2 * n_passes { done_r = 1 }
    }
    done = done_r
    passes = passes_r
    mismatches = mism
    reads_ok = rd_ok
    gen_state = g_st
    init_done = ctrl.init_done
    train_fail = ctrl.train_fail
    ctrl_state = ctrl.state
    mr5 = ctrl.mr5
    mr8 = ctrl.mr8
    gate0 = phy.gate_dly0
    gate1 = phy.gate_dly1
    gate_map0 = phy.gate_map0
    rdly0 = phy.rd_dly0
    rdly1 = phy.rd_dly1
    lvl_fail = phy.lvl_fail
    wl0 = phy.wl_dly0
    wl1 = phy.wl_dly1
    wdq0 = phy.wdq_dly0
    bit_pos0 = phy.bit_pos0
    bit_pos1 = phy.bit_pos1
    bit_fail0 = phy.bit_fail0
    dqs0 = phy.dqs_dly0
    dqs1 = phy.dqs_dly1
    bit_fail1 = phy.bit_fail1
    wdq1 = phy.wdq_dly1
    wrlvl_fail = phy.wrlvl_fail
    wdq_fail = phy.wdq_fail
    gate_fail = phy.gate_fail
    dll_lock = phy.dll_lock
    bursts0 = phy.bursts0
    bursts1 = phy.bursts1
    ctrlupd_count = phy.ctrlupd_count
    phyupd_count = phy.phyupd_count
    m_errors = dram.errors
    m_err_code = dram.err_code
    m_err_cycle = dram.err_cycle
    m_contention = dram.contention
    m_dq_viol = dram.dq_viol
    m_dq_viol_init = viol_init
    m_n_wr_init = nwr_init
    m_aliased = dram.aliased
    m_unwritten = dram.unwritten
    m_n_act = dram.n_act
    m_n_wr = dram.n_wr
    m_n_rd = dram.n_rd
    m_n_mrw = dram.n_mrw
    m_n_mrr = dram.n_mrr
    m_n_ref = dram.n_ref
    m_n_zq = dram.n_zq
    m_t_ck = dram.t_ck_clks
    vref = ctrl.vref
    vref_win = ctrl.vref_win
    wl_relevels = ctrl.wl_relevels
    vref_map = ctrl.vref_map
}
