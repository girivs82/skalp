// Functions with local bindings, called in continuous assignments: lowering
// them creates let variables for this module
fn rr_pick(rr: bit[2], v: bit[4]) -> bit[2] {
    let rot: bit[4] = match rr {
        0 => v,
        1 => ({v[0], v[3:1]}),
        2 => ({v[1:0], v[3:2]}),
        _ => ({v[2:0], v[3]})
    }
    let p: bit[2] = if rot[0] == 1 { 2'b00 } else if rot[1] == 1 { 2'b01 } else if rot[2] == 1 { 2'b10 } else { 2'b11 }
    return p + rr
}

fn sext8(x: bit[8]) -> bit[16] {
    let sg: bit = x[7]
    return {{8{sg}}, x}
}

entity Picker {
    in rr: bit[2]
    in v: bit[4]
    in x: bit[8]
    out o: bit[2]
    out w: bit[16]
}

impl Picker {
    let any: bit = if v != 0 { 1'b1 } else { 1'b0 }
    signal pk: bit[2]
    pk = rr_pick(rr, v)
    o = if any == 1 { pk } else { 2'b00 }
    w = sext8(x)
}
