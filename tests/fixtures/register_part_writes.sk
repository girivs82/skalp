// Registers written in parts: a whole-register reset, single bits, a range,
// a run-time index and two parts in one cycle; one register is an output port.
entity Parts {
    in clk: clock
    in rst: bit
    in op: bit[2]
    in idx: bit[3]
    in v: bit[4]
    out r: bit[8]
    out p: bit[8]
}
impl Parts {
    signal flags: bit[8] = 8'hA5
    on(clk.rise) {
        if (rst == 1) {
            flags = 0
            p = 8'h0F
        } else {
            if (op == 0) {
                flags[1] = 1
                flags[6] = v[0]
            } else if (op == 1) {
                flags[7:4] = v
            } else if (op == 2) {
                flags[idx] = 1
                p[idx] = 0
            } else {
                flags = {flags[3:0], flags[7:4]}
                p[3:0] = v
            }
        }
    }
    r = flags
}
