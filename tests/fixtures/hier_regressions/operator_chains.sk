// Chains of same-precedence operators under a lower-precedence one
entity OpChains {
    in a: bit[8]
    in b: bit[8]
    in c: bit[8]
    in d: bit[8]
    out sub_chain: bit[8]
    out eq_sum: bit
    out ge_diff: bit
    out mask: bit[8]
    out mul_eq: bit
    out logic_mix: bit
}
impl OpChains {
    sub_chain = a - b - c + d
    eq_sum = if a == b + c + d { 1 } else { 0 }
    ge_diff = if a + 1 >= b - c - 1 { 1 } else { 0 }
    mask = (a | b | c) & d & 15
    mul_eq = if a == b * 2 * c { 1 } else { 0 }
    logic_mix = a[0] == 1 && b[0] == 1 && c[0] == 1 || d[0] == 1
}
