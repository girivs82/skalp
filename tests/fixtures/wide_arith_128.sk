// 65..128-bit values in the compiled behavioral simulator: a constant, a
// 48x48 multiply with its full 96-bit product, 96-bit add/subtract, and an
// unaligned 72-bit slice of a 160-bit (limb-array) value.

entity WideArith {
    in clk: clock
    in a: bit[48]
    in b: bit[48]
    out prod_lo: bit[48]
    out prod_hi: bit[48]
    out sum_hi: bit[48]
    out diff_lo: bit[48]
    out mid: bit[48]
}

impl WideArith {
    signal prod: bit[96] = {48'b0, a} * {48'b0, b}
    signal bias: bit[96] = {32'h1, 64'h3}
    signal sum: bit[96] = prod + bias
    signal diff: bit[96] = prod - bias
    signal r: bit[96] = 0
    signal wide: bit[160] = {prod[95:0], 64'h0123456789ABCDEF}
    signal m: bit[72] = wide[119:48]

    on(clk.rise) {
        r = prod
    }

    prod_lo = r[47:0]
    prod_hi = r[95:48]
    sum_hi = sum[95:48]
    diff_lo = diff[47:0]
    mid = m[71:24]
}
