// An LVSTL_I output and an LVSTL_I bidirectional pad (a vendor BB buffer on
// an inout port) in bank 3, with the read-back shown on an LED.

#[lattice_ip(name = "BB")]
entity BB {
    in I: bit
    in T: bit
    out O: bit
    inout B: bit
}

entity LvstlBidir {
    in clk: clock @ { pin: "P24", io_standard: "LVCMOS33" }
    out ca: bit @ { pin: "AE23", io_standard: "LVSTL_I" }
    inout dq: bit @ { pin: "AA6", io_standard: "LVSTL_I" }
    out led: bit @ { pin: "R8", io_standard: "LVCMOS33" }
}

impl LvstlBidir {
    signal n: bit[8] = 0
    signal seen: bit = 0
    inst pad = BB {
        I: n[0],
        T: n[7],
        B: dq
    }
    on(clk.rise) {
        n = n + 1
        seen = pad.O
    }
    ca = n[1]
    led = seen
}
