// The read data decides a branch directly, so it must be valid in the same cycle.
entity RamCombRead {
    in clk: clock
    in addr: bit[9]
    in wdata: bit[8]
    out seen: bit
}
impl RamCombRead {
    signal mem: bit[8][512]
    signal flag: bit = 0
    on(clk.rise) {
        mem[addr] = wdata
        if mem[addr] == 8'd3 {
            flag = 1
        }
    }
    seen = flag
}
