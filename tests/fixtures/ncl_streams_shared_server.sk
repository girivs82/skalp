// Four clients share one self-timed server over request and reply streams.
//
// Each client sends a value, waits for the reply (the value plus one) and
// keeps a count and a sum of the replies. The server takes requests through
// a four-way `match arbitrate`, parks each in a pending register and works
// on one at a time, in turn, for a few steps (its `_ if` arm keeps it stepping while
// work is pending or in hand). New requests keep arriving while the server
// is busy, so the arbiter sees requests rise and fall in every pattern.

async entity SsClient {
    out q: stream<bit[8]>
    in r: stream<bit[8]>
    out n: bit[16]
    out sum: bit[16]
}

impl SsClient {
    signal cnt: bit[16] = 0
    signal total: bit[16] = 0
    signal waiting: bit = 0
    on() {
        if waiting == 0 {
            if cnt != 32 {
                q.send(cnt[7:0])
                waiting = 1
            }
        } else {
            let v: bit[8] = r.recv()
            total = total + {8'h00, v}
            cnt = cnt + 1
            waiting = 0
        }
    }
    n = cnt
    sum = total
}

async entity SsServer {
    in q0: stream<bit[8]>
    in q1: stream<bit[8]>
    in q2: stream<bit[8]>
    in q3: stream<bit[8]>
    out r0: stream<bit[8]>
    out r1: stream<bit[8]>
    out r2: stream<bit[8]>
    out r3: stream<bit[8]>
}

impl SsServer {
    signal pk0: bit[8] = 0
    signal pk1: bit[8] = 0
    signal pk2: bit[8] = 0
    signal pk3: bit[8] = 0
    signal pv0: bit = 0
    signal pv1: bit = 0
    signal pv2: bit = 0
    signal pv3: bit = 0
    signal busy: bit = 0
    signal cur: bit[2] = 0
    signal left: bit[3] = 0
    signal val: bit[8] = 0
    signal pending: bit
    pending = pv0 | pv1 | pv2 | pv3
    // the next pending request after the one served last, 4 if none
    signal rot: bit[4]
    rot = if cur == 0 { {pv0, pv3, pv2, pv1} } else if cur == 1 { {pv1, pv0, pv3, pv2} } else if cur == 2 { {pv2, pv1, pv0, pv3} } else { {pv3, pv2, pv1, pv0} }
    signal skip: bit[3]
    skip = if rot[0] == 1 { 3'h1 } else if rot[1] == 1 { 3'h2 } else if rot[2] == 1 { 3'h3 } else if rot[3] == 1 { 3'h4 } else { 3'h0 }
    signal pick: bit[3]
    pick = if skip == 0 { 3'h4 } else { {1'b0, cur + skip[1:0]} }
    signal done: bit
    done = if busy == 1 && left == 0 { 1'b1 } else { 1'b0 }
    on() {
        match arbitrate(q0, q1, q2, q3) {
            0 => {
                let p0: bit[8] = q0.recv()
                pk0 = p0
                pv0 = 1
            }
            1 => {
                let p1: bit[8] = q1.recv()
                pk1 = p1
                pv1 = 1
            }
            2 => {
                let p2: bit[8] = q2.recv()
                pk2 = p2
                pv2 = 1
            }
            3 => {
                let p3: bit[8] = q3.recv()
                pk3 = p3
                pv3 = 1
            }
            _ if busy == 1 || pending == 1 => {
            }
        }
        if done == 1 && cur == 0 {
            r0.send(val)
        }
        if done == 1 && cur == 1 {
            r1.send(val)
        }
        if done == 1 && cur == 2 {
            r2.send(val)
        }
        if done == 1 && cur == 3 {
            r3.send(val)
        }
        if busy == 1 {
            if left == 0 {
                busy = 0
            } else {
                left = left - 3'h1
            }
        } else if pick != 4 {
            busy = 1
            cur = pick[1:0]
            if pick == 0 {
                val = pk0 + 8'h01
                left = pk0[2:0]
                pv0 = 0
            }
            if pick == 1 {
                val = pk1 + 8'h01
                left = pk1[2:0]
                pv1 = 0
            }
            if pick == 2 {
                val = pk2 + 8'h01
                left = pk2[2:0]
                pv2 = 0
            }
            if pick == 3 {
                val = pk3 + 8'h01
                left = pk3[2:0]
                pv3 = 0
            }
        }
    }
}

entity SsTop {
    in clk: clock
    in run: bit
    out n0: bit[16]
    out n1: bit[16]
    out n2: bit[16]
    out n3: bit[16]
    out sum0: bit[16]
    out sum1: bit[16]
    out sum2: bit[16]
    out sum3: bit[16]
    out busy: bit
}

impl SsTop {
    signal req: bit = 0

    inst c0 = SsClient { r: s.r0, ncl_req: req }
    inst c1 = SsClient { r: s.r1, ncl_req: req }
    inst c2 = SsClient { r: s.r2, ncl_req: req }
    inst c3 = SsClient { r: s.r3, ncl_req: req }
    inst s = SsServer { q0: c0.q, q1: c1.q, q2: c2.q, q3: c3.q, ncl_req: req }

    on(clk.rise) {
        req = run
    }
    n0 = c0.n
    n1 = c1.n
    n2 = c2.n
    n3 = c3.n
    sum0 = c0.sum
    sum1 = c1.sum
    sum2 = c2.sum
    sum3 = c3.sum
    busy = c0.ncl_ack | c1.ncl_ack | c2.ncl_ack | c3.ncl_ack | s.ncl_ack
}
