// A clocked parent driving async (NCL) instances through their implicit
// `ncl_req`/`ncl_ack` handshake: a combinational adder and an accumulator
// whose register is written once per request.

async entity HsAdd8 {
    in a: bit[8]
    in b: bit[8]
    out s: bit[8]
}

impl HsAdd8 {
    s = a + b
}

async entity HsAcc8 {
    in a: bit[8]
    out s: bit[8]
}

impl HsAcc8 {
    signal acc: bit[8] = 0
    on() {
        acc = acc + a
    }
    s = acc
}

entity HsTop {
    in clk: clock
    in x: bit[8]
    in y: bit[8]
    in go: bit
    out sum: bit[8]
    out total: bit[8]
    out done: bit
}

impl HsTop {
    signal xr: bit[8] = 0
    signal yr: bit[8] = 0
    signal req: bit = 0
    signal sum_r: bit[8] = 0
    signal total_r: bit[8] = 0

    inst add = HsAdd8 { a: xr, b: yr, ncl_req: req }
    inst acc = HsAcc8 { a: xr, ncl_req: req }

    on(clk.rise) {
        xr = x
        yr = y
        req = go
        sum_r = add.s
        total_r = acc.s
    }
    sum = sum_r
    total = total_r
    done = add.ncl_ack & acc.ncl_ack
}

// An async register file: one write per request, combinational read. Its
// storage is a memory clocked by the request strobe like any register.
async entity HsRf {
    in we: bit
    in wa: bit[3]
    in wd: bit[8]
    in ra: bit[3]
    out rd: bit[8]
}

impl HsRf {
    signal mem: bit[8][8]
    on() {
        if we {
            mem[wa] = wd
        }
    }
    rd = mem[ra]
}

entity HsRfTop {
    in clk: clock
    in we: bit
    in wa: bit[3]
    in wd: bit[8]
    in ra: bit[3]
    in go: bit
    out rd: bit[8]
    out done: bit
}

impl HsRfTop {
    signal we_r: bit = 0
    signal wa_r: bit[3] = 0
    signal wd_r: bit[8] = 0
    signal ra_r: bit[3] = 0
    signal req: bit = 0
    signal rd_r: bit[8] = 0

    inst rf = HsRf { we: we_r, wa: wa_r, wd: wd_r, ra: ra_r, ncl_req: req }

    on(clk.rise) {
        we_r = we
        wa_r = wa
        wd_r = wd
        ra_r = ra
        req = go
        rd_r = rf.rd
    }
    rd = rd_r
    done = rf.ncl_ack
}
