// An LVSTL_I bidirectional pad in bank 3 whose input reference level is set
// on the pad itself (`vref: "245mV"`), the vendor-neutral way: the backend
// adds the bank's reference generator at the nearest level it has.

#[lattice_ip(name = "BB")]
entity BB {
    in I: bit
    in T: bit
    out O: bit
    inout B: bit
}

entity LvstlPadVref {
    in clk: clock @ { pin: "P24", io_standard: "LVCMOS33" }
    inout dq: bit @ { pin: "AA6", io_standard: "LVSTL_I", vref: "245mV" }
    out led: bit @ { pin: "R8", io_standard: "LVCMOS33" }
}

impl LvstlPadVref {
    signal n: bit[8] = 0
    signal seen: bit = 0
    inst pad = BB {
        I: n[0],
        T: n[7],
        B: dq
    }
    on(clk.rise) {
        n = n + 1
        seen = pad.O
    }
    led = seen
}
