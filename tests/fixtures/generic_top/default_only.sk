// A generic counter whose step defaults to 2, used on its own.
entity Stepper<const STEP: nat = 2> {
    in clk: clock
    in rst: bit
    out count: bit[8]
}

impl Stepper {
    signal c: bit[8] = 0
    on(clk.rise) {
        if rst == 1 {
            c = 0
        } else {
            c = c + STEP
        }
    }
    count = c
}
