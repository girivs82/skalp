// `taken(s)`: a step that takes a value from `s` through `match arbitrate`
// can use that value outside the arm, in the same step

async entity TkSource {
    out q: stream<bit[8]>
}
impl TkSource {
    signal n: bit[8] = 1
    on() {
        q.send(n)
        n = n + 8'h01
    }
}

// Forwards each odd value from `a` in the step that takes it (whether the
// step sends reads the value taken), counts the even ones, and adds up the
// values from `b`
async entity TkForward {
    in a: stream<bit[8]>
    in b: stream<bit[8]>
    out o: stream<bit[8]>
    out total: bit[16]
    out nb: bit[16]
    out even: bit[16]
}
impl TkForward {
    signal t: bit[16] = 0
    signal c: bit[16] = 0
    signal ev: bit[16] = 0
    total = t
    nb = c
    even = ev
    on() {
        match arbitrate(a, b) {
            0 => {
                let x: bit[8] = a.recv()
            }
            1 => {
                let y: bit[8] = b.recv()
                t = t + {8'h00, y}
                c = c + 16'h0001
            }
        }
        if taken(a) == 1 && a[0] == 1 {
            o.send(a)
        }
        if taken(a) == 1 && a[0] == 0 {
            ev = ev + 16'h0001
        }
    }
}

// Checks that it receives 1, 3, 5, ... in order
async entity TkSink {
    in o: stream<bit[8]>
    out count: bit[16]
    out bad: bit
}
impl TkSink {
    signal c: bit[16] = 0
    signal e: bit[8] = 1
    signal bd: bit = 0
    count = c
    bad = bd
    on() {
        let v: bit[8] = o.recv()
        if v != e {
            bd = 1
        }
        e = e + 8'h02
        c = c + 16'h0001
    }
}

entity TkTop {
    in clk: clock
    in run: bit
    out count: bit[16]
    out bad: bit
    out total: bit[16]
    out nb: bit[16]
    out even: bit[16]
}
impl TkTop {
    signal req: bit = 0
    inst sa = TkSource { ncl_req: req }
    inst sb = TkSource { ncl_req: req }
    inst f = TkForward { a: sa.q, b: sb.q, ncl_req: req }
    inst k = TkSink { o: f.o, ncl_req: req }
    on(clk.rise) { req = run }
    count = k.count
    bad = k.bad
    total = f.total
    nb = f.nb
    even = f.even
}

// `ready(s)`: sends each value to whichever of two sinks is free, the
// first one first

async entity RdSplit {
    in i: stream<bit[8]>
    out o0: stream<bit[8]>
    out o1: stream<bit[8]>
}
impl RdSplit {
    signal v: bit[8] = 0
    signal full: bit = 0
    on() {
        if full == 0 {
            let x: bit[8] = i.recv()
            v = x
            full = 1
        } else if ready(o0) == 1 {
            o0.send(v)
            full = 0
        } else {
            o1.send(v)
            full = 0
        }
    }
}

// A sink that takes a value every `slow + 1` steps and adds them up
async entity RdSink {
    in o: stream<bit[8]>
    out count: bit[16]
    out sum: bit[16]
}
impl RdSink {
    signal c: bit[16] = 0
    signal s: bit[16] = 0
    signal wait: bit[2] = 0
    count = c
    sum = s
    on() {
        if wait == 0 {
            let v: bit[8] = o.recv()
            c = c + 16'h0001
            s = s + {8'h00, v}
            wait = 3
        } else {
            wait = wait - 2'h1
        }
    }
}

entity RdTop {
    in clk: clock
    in run: bit
    out count0: bit[16]
    out count1: bit[16]
    out sum: bit[16]
}
impl RdTop {
    signal req: bit = 0
    inst src = TkSource { ncl_req: req }
    inst sp = RdSplit { i: src.q, ncl_req: req }
    inst k0 = RdSink { o: sp.o0, ncl_req: req }
    inst k1 = RdSink { o: sp.o1, ncl_req: req }
    on(clk.rise) { req = run }
    count0 = k0.count
    count1 = k1.count
    sum = k0.sum + k1.sum
}
