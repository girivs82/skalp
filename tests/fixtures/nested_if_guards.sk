// Registers assigned under nested conditions, reached only through the inner branch.
entity NestedIfGuards {
    in clk: clock
    in a: bit
    in b: bit
    out t: bit
    out u: bit
}
impl NestedIfGuards {
    signal t_reg: bit = 0
    signal u_reg: bit = 0
    on(clk.rise) {
        if a == 1 {
            if b == 1 {
                t_reg = 1
            }
        } else {
            if b == 1 {
                u_reg = 1
            }
        }
    }
    t = t_reg
    u = u_reg
}
