// Synchronous FIFO with configurable depth and width
entity sync_fifo<const WIDTH: usize, const DEPTH: usize> {
    in clk: clock;
    in rst: reset;

    // Write interface
    in write_data: bit<WIDTH>;
    in write_enable: bit;
    out full: bit;

    // Read interface
    out read_data: bit<WIDTH>;
    in read_enable: bit;
    out empty: bit;

    // Status
    out fill_count: bit<log2(DEPTH+1)>;
}

impl sync_fifo {
    // Internal storage
    signal memory: Array<bit<WIDTH>, DEPTH>;
    signal write_ptr: bit<log2(DEPTH)>;
    signal read_ptr: bit<log2(DEPTH)>;
    signal count: bit<log2(DEPTH+1)>;

    on(clk.rise) {
        if rst.active {
            write_ptr = 0;
            read_ptr = 0;
            count = 0;
        } else {
            // Handle simultaneous read/write: concatenate the two
            // qualified strobes into a 2-bit value and match on it
            match {write_enable && !full, read_enable && !empty} {
                0b11 => {
                    // Read and write - count unchanged
                    memory[write_ptr] = write_data;
                    write_ptr = write_ptr + 1;
                    read_ptr = read_ptr + 1;
                },
                0b10 => {
                    // Write only
                    memory[write_ptr] = write_data;
                    write_ptr = write_ptr + 1;
                    count = count + 1;
                },
                0b01 => {
                    // Read only
                    read_ptr = read_ptr + 1;
                    count = count - 1;
                },
                _ => {
                    // No operation
                }
            }
        }
    }

    // Combinational outputs
    read_data = memory[read_ptr];
    full = (count == DEPTH);
    empty = (count == 0);
    fill_count = count;

    // Immediate assertions for verification (checked every cycle in simulation)
    assert(!(write_enable && full), "write while full");
    assert(!(read_enable && empty), "read while empty");
    assert(count <= DEPTH, "count within capacity");
}
